<!DOCTYPE html>
<html lang="id" data-theme="light">
<head>
    <%- include('../template/head'); %>
    <!-- fullCalendar -->
    <link rel="stylesheet" href="/asset/css/presensi/absen.css">
    <link rel="stylesheet" href="/asset/css/presensi/jdldns.css">
    <script src="https://cdn.jsdelivr.net/npm/@vladmandic/face-api@1.0.1/dist/face-api.min.js"></script>
</head>

<body class="bg-base-200 text-base-content font-sans antialiased">
    <!-- Wrapper Utama Drawer DaisyUI -->
    <div class="drawer lg:drawer-open">
        <input id="main-drawer" type="checkbox" class="drawer-toggle" />
        
        <!-- Konten Utama -->
        <div class="drawer-content flex flex-col min-h-screen">
            
            <!-- Navbar -->
            <%- include('../template/navbar'); %>

            <!-- Content Header -->
            <header class="w-full p-4 md:p-6 pb-2">
                <div class="flex flex-col md:flex-row md:items-center justify-between gap-4">
                    <div>
                        <h1 class="text-2xl font-bold tracking-tight text-base-content">Presensi Kehadiran</h1>
                        <p class="text-sm text-base-content/70 mt-1">Jadwal Dinas, riwayat kehadiran, dan rekapitulasi.</p>
                    </div>
                    <div class="breadcrumbs text-sm">
                        <ul>
                            <li><a href="/">Home</a></li>
                            <li class="font-semibold">Presensi</li>
                        </ul>
                    </div>
                </div>
            </header>

            <!-- Main content -->
            <main class="flex-1 p-4 md:p-6 space-y-6">
                
                <!-- Section: Jadwal Dinas & Kontrol -->
                <section class="card bg-base-100 shadow-sm border border-base-200">
                    <div class="card-body p-5 md:p-6">
                        <h2 class="card-title text-xl text-primary border-b border-base-200 pb-3 mb-4">
                            <i class="fas fa-calendar-day"></i> Jadwal Dinas Hari Ini
                        </h2>
                        
                        <!-- Info Shift -->
                        <div class="bg-base-200/50 p-5 rounded-xl border border-base-200 space-y-3 mb-6 max-w-lg">
                            <div class="flex justify-between items-center border-b border-base-300 pb-2">
                                <span class="font-medium text-base-content/70">Nama Shift:</span>
                                <span class="font-bold text-base-content" id="typeShift">-</span>
                            </div>
                            <div class="flex justify-between items-center border-b border-base-300 pb-2">
                                <span class="font-medium text-base-content/70">Masuk:</span>
                                <span class="font-bold text-base-content" id="MasukShift">-</span>
                            </div>
                            <div class="flex justify-between items-center">
                                <span class="font-medium text-base-content/70">Pulang:</span>
                                <span class="font-bold text-base-content" id="PulangShift">-</span>
                            </div>
                        </div>

                        <!-- Kontrol Periode -->
                        <div class="flex flex-col sm:flex-row items-end gap-4 mb-6">
                            <div class="form-control w-full sm:w-auto">
                                <label class="label pt-0"><span class="label-text font-medium text-base-content/70">Pilih Periode</span></label>
                                <input type="month" class="input input-bordered w-full hover:border-primary focus:border-primary transition-colors" id="periode" name="periode">
                            </div>
                            <button type="button" id="jadwalDNSModal" class="btn btn-primary shadow-sm" onclick="document.getElementById('jadwalDNSModalModern').showModal()">
                                <i class="fas fa-calendar-alt mr-1"></i> Lihat Jadwal DNS
                            </button>
                        </div>

                        <!-- Container Riwayat -->
                        <div id="absensi-list"></div> 
                        <div id="listKehadiran" class="space-y-4"></div>
                    </div>
                </section>

                <!-- Section: Recap Presensi -->
                <section class="card bg-base-100 shadow-sm border border-base-200">
                    <div class="card-body p-5 md:p-6">
                        <h2 class="card-title text-xl text-primary border-b border-base-200 pb-3 mb-4">
                            <i class="fas fa-chart-pie"></i> Rekapitulasi Presensi
                        </h2>
                        
                        <!-- Grid Diperbarui agar lebih responsif (1 kolom di HP, 2 di Tablet, 3 di Desktop Besar) -->
                        <div class="grid grid-cols-1 md:grid-cols-2 xl:grid-cols-3 gap-4">
                            
                            <!-- Hari Kerja -->
                            <div class="bg-green-50 p-4 rounded-xl flex items-center space-x-4 border border-green-100">
                                <i class="fa-solid fa-briefcase text-green-600 text-3xl opacity-80"></i>
                                <div>
                                    <p class="text-sm font-medium text-green-800/70">Hari Kerja</p>
                                    <p class="font-bold text-2xl text-green-700"><span id="hariKerja">0</span></p>
                                </div>
                            </div>

                            <!-- Total Libur (Span 1 baris di tablet, tetap estetik) -->
                            <div class="bg-red-50 p-4 rounded-xl border border-red-100 md:row-span-2 flex flex-col justify-center">
                                <div class="flex items-center space-x-4 mb-3">
                                    <i class="fa-solid fa-calendar-xmark text-red-600 text-3xl opacity-80"></i>
                                    <div>
                                        <p class="text-sm font-medium text-red-800/70">Total Libur</p>
                                        <p class="font-bold text-2xl text-red-700"><span id="totalLibur">0</span></p>
                                    </div>
                                </div>
                                <ul class="text-sm text-red-900/70 ml-2 space-y-1 bg-red-100/50 p-3 rounded-lg" id="listLibur">
                                    <li class="flex justify-between"><span>Libur:</span> <span class="font-bold">x</span></li>
                                    <li class="flex justify-between"><span>Dinas Luar (DL):</span> <span class="font-bold">x</span></li>
                                    <li class="flex justify-between"><span>Cuti Tahunan (CT):</span> <span class="font-bold">x</span></li>
                                    <li class="flex justify-between"><span>Cuti Bersama (CB):</span> <span class="font-bold">x</span></li>
                                </ul>
                            </div>

                            <!-- Masuk Tepat Waktu -->
                            <div class="bg-blue-50 p-4 rounded-xl flex items-center space-x-4 border border-blue-100">
                                <i class="fa-solid fa-clock text-blue-600 text-3xl opacity-80"></i>
                                <div>
                                    <p class="text-sm font-medium text-blue-800/70">Masuk Tepat Waktu</p>
                                    <p class="font-bold text-2xl text-blue-700"><span id="masukTepatWaktu">0</span></p>
                                </div>
                            </div>

                            <!-- Pulang Tepat Waktu -->
                            <div class="bg-indigo-50 p-4 rounded-xl flex items-center space-x-4 border border-indigo-100">
                                <i class="fa-solid fa-person-walking-arrow-loop-left text-indigo-600 text-3xl opacity-80"></i>
                                <div>
                                    <p class="text-sm font-medium text-indigo-800/70">Pulang Tepat Waktu</p>
                                    <p class="font-bold text-2xl text-indigo-700"><span id="pulangTepatWaktu">0</span></p>
                                </div>
                            </div>

                            <!-- Telat Masuk -->
                            <div class="bg-amber-50 p-4 rounded-xl flex items-center space-x-4 border border-amber-100">
                                <i class="fa-solid fa-person-running text-amber-600 text-3xl opacity-80"></i>
                                <div>
                                    <p class="text-sm font-medium text-amber-800/70">Terlambat Masuk</p>
                                    <p class="font-bold text-2xl text-amber-700"><span id="terlambatMasuk">0</span> <span class="text-sm font-normal">menit</span></p>
                                </div>
                            </div>

                            <!-- Cepat Pulang -->
                            <div class="bg-pink-50 p-4 rounded-xl flex items-center space-x-4 border border-pink-100">
                                <i class="fa-solid fa-person-walking-dashed-line-arrow-right text-pink-600 text-3xl opacity-80"></i>
                                <div>
                                    <p class="text-sm font-medium text-pink-800/70">Cepat Pulang</p>
                                    <p class="font-bold text-2xl text-pink-600"><span id="cepatPulang">0</span> <span class="text-sm font-normal">menit</span></p>
                                </div>
                            </div>

                            <!-- Tidak Absen Masuk -->
                            <div class="bg-slate-100 p-4 rounded-xl flex items-center space-x-4 border border-slate-200">
                                <i class="fa-solid fa-door-closed text-slate-500 text-3xl opacity-80"></i>
                                <div>
                                    <p class="text-sm font-medium text-slate-600">Tidak Absen Masuk</p>
                                    <p class="font-bold text-2xl text-slate-700"><span id="tidakAbsenMasuk">0</span></p>
                                </div>
                            </div>

                            <!-- Tidak Absen Pulang -->
                            <div class="bg-slate-100 p-4 rounded-xl flex items-center space-x-4 border border-slate-200">
                                <i class="fa-solid fa-door-open text-slate-500 text-3xl opacity-80"></i>
                                <div>
                                    <p class="text-sm font-medium text-slate-600">Tidak Absen Pulang</p>
                                    <p class="font-bold text-2xl text-slate-700"><span id="tidakAbsenPulang">0</span></p>
                                </div>
                            </div>

                            <!-- Tidak Absen Umum -->
                            <div class="bg-slate-100 p-4 rounded-xl flex items-center space-x-4 border border-slate-200">
                                <i class="fa-solid fa-user-slash text-slate-500 text-3xl opacity-80"></i>
                                <div>
                                    <p class="text-sm font-medium text-slate-600">Total Tidak Absen</p>
                                    <p class="font-bold text-2xl text-slate-700"><span id="tidakAbsen">0</span></p>
                                </div>
                            </div>
                        </div>

                    </div>
                </section>

            </main>
            
            <!-- Footer -->
            <footer class="footer footer-center p-4 bg-base-100 text-base-content border-t border-base-300 mt-auto">
                <aside>
                    <p>Copyright © <%= new Date().getFullYear() %> - RSUD dr. Abdul Aziz</p>
                </aside>
            </footer>
        </div>

        <!-- Sidebar Utama -->
        <%- include('../template/sidebar'); %>
    </div>

    <!-- Modals -->
    <%- include('../modal/modalJadwal'); %>

    <%- include('../template/footer'); %>
    <!-- fullCalendar -->
    <script src="https://cdnjs.cloudflare.com/ajax/libs/moment.js/2.30.1/moment.min.js"></script>
    <script src="/asset/js/fullcalendar/riwayat2.js"></script>
    <script src="/asset/js/fullcalendar/jdl.js"></script>
    <script src="/asset/js/fullcalendar/jdldnsme.js"></script>
</body>
</html>