<!DOCTYPE html>
<html lang="id" data-theme="light">

<head>
  <%- include('../template/head'); %>
  <meta name="description" content="Manajemen Data Pegawai RSUD dr. Abdul Aziz Singkawang">
  <!-- Tabulator CSS -->
  <link href="https://unpkg.com/tabulator-tables@6.3.1/dist/css/tabulator.min.css" rel="stylesheet">
  <script type="text/javascript" src="https://unpkg.com/tabulator-tables@6.3.1/dist/js/tabulator.min.js"></script>
  
  <style>
    /* Styling kustom untuk tombol edit di dalam Tabulator */
    .edit-btn {
      background-color: #22c55e; /* Tailwind green-500 */
      color: white;
      border: none;
      padding: 4px 10px;
      cursor: pointer;
      border-radius: 6px;
      font-size: 0.75rem;
      font-weight: 600;
      transition: background-color 0.2s;
    }
    .edit-btn:hover {
      background-color: #16a34a; /* Tailwind green-600 */
    }
  </style>
</head>

<body class="bg-base-200 text-base-content font-sans antialiased">
  <!-- Wrapper Utama Drawer DaisyUI -->
  <div class="drawer lg:drawer-open">
    <input id="main-drawer" type="checkbox" class="drawer-toggle" />
    
    <!-- Konten Utama -->
    <div class="drawer-content flex flex-col min-h-screen">
      
      <!-- Navbar -->
      <%- include('../template/navbar'); %>

      <!-- Content Header -->
      <header class="w-full p-4 md:p-6 pb-2">
        <div class="flex flex-col md:flex-row md:items-center justify-between gap-4">
          <div>
            <h1 class="text-2xl font-bold tracking-tight"><%= page %></h1>
          </div>
          <div class="breadcrumbs text-sm">
            <ul>
              <li><a href="/">Home</a></li>
              <li class="font-semibold">Data Pegawai</li>
            </ul>
          </div>
        </div>
      </header>

      <!-- Main content -->
      <main class="flex-1 p-4 md:p-6">
        <div class="container mx-auto max-w-7xl space-y-6">
          
          <!-- Card Utama -->
          <div class="card bg-base-100 shadow-xl border border-base-200 overflow-hidden">
            <div class="card-body p-5 md:p-6 space-y-4">
              
              <!-- Card Header / Title & Tombol Export -->
              <div class="flex flex-col sm:flex-row sm:items-center justify-between gap-3 pb-4 border-b border-base-200">
                <h2 class="card-title text-base md:text-lg font-bold text-base-content">
                  <i class="fas fa-users text-primary mr-2"></i> Daftar Seluruh Pegawai
                </h2>
                <button type="button" id="download-xlsx" class="btn btn-success btn-sm md:btn-md text-white gap-2 shadow-sm">
                  <i class="fas fa-file-excel"></i> Export ke Excel
                </button>
              </div>

              <!-- Input Pencarian -->
              <div class="w-full sm:w-80">
                <input 
                  id="search-input" 
                  type="search" 
                  placeholder="Cari nama, NIP, atau jabatan..." 
                  class="input input-bordered input-sm md:input-md w-full hover:border-primary focus:border-primary transition-colors" 
                />
              </div>

              <!-- Tabulator Table Container -->
              <div class="w-full overflow-x-auto rounded-xl border border-base-300">
                <div id="tableDataPegawi" class="w-full"></div>
              </div>

            </div>
          </div>

        </div>
      </main>

      <!-- Footer -->
      <footer class="footer footer-center p-4 bg-base-100 text-base-content border-t border-base-300 mt-auto">
        <aside>
          <p>Copyright © <%= new Date().getFullYear() %> RSUD dr. Abdul Aziz</p>
        </aside>
      </footer>
    </div>

    <!-- Sidebar Utama -->
    <%- include('../template/sidebar'); %>
  </div>

  <!-- Footer Scripts -->
  <%- include('../template/footer'); %>
  <script src="https://cdnjs.cloudflare.com/ajax/libs/Chart.js/3.8.0/chart.min.js"></script>
  <script src="https://cdnjs.cloudflare.com/ajax/libs/xlsx/0.18.5/xlsx.full.min.js"></script>
  <script src="/asset/js/admin/data_pegawai.js"></script>
</body>

</html>