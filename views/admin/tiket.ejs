<!DOCTYPE html>
<html lang="id" data-theme="light">

<head>
  <%- include('../template/head'); %>
  <meta name="description" content="Detail dan Update Tiket Bantuan TI RSUD dr. Abdul Aziz Singkawang">
</head>

<body class="bg-base-200 text-base-content font-sans antialiased">
  <!-- Wrapper Utama Drawer DaisyUI -->
  <div class="drawer lg:drawer-open">
    <input id="main-drawer" type="checkbox" class="drawer-toggle" />
    
    <!-- Konten Utama -->
    <div class="drawer-content flex flex-col min-h-screen">
      
      <!-- Navbar -->
      <%- include('../template/navbar'); %>

      <!-- Content Header -->
      <header class="w-full p-4 md:p-6 pb-2">
        <div class="flex flex-col md:flex-row md:items-center justify-between gap-4">
          <div>
            <h1 class="text-2xl font-bold tracking-tight">Detail & Update Tiket</h1>
          </div>
          <div class="breadcrumbs text-sm">
            <ul>
              <li><a href="/">Home</a></li>
              <li><a href="/helpdeskadmin">Helpdesk Admin</a></li>
              <li class="font-semibold">Detail Tiket</li>
            </ul>
          </div>
        </div>
      </header>

      <!-- Main content -->
      <main class="flex-1 p-4 md:p-6 space-y-6">
        <div class="container mx-auto max-w-7xl space-y-6">
          
          <!-- Card 1: Riwayat & Detail Tiket -->
          <div class="card bg-base-100 shadow-xl border border-base-200 overflow-hidden">
            <div class="card-body p-5 md:p-6 space-y-4">
              
              <!-- Card Header / Title & Tombol Kembali -->
              <div class="flex flex-col sm:flex-row sm:items-center justify-between gap-3 pb-4 border-b border-base-200">
                <div>
                  <span class="text-xs font-semibold text-primary uppercase tracking-wider">No. Tiket Pengaduan</span>
                  <h2 class="text-2xl md:text-3xl font-extrabold text-base-content" id="id"><%= id %></h2>
                </div>
                <button type="button" class="btn btn-warning btn-sm md:btn-md gap-2 shadow-sm text-white" onclick="window.location.href='/helpdeskadmin'">
                  <i class="fas fa-arrow-left"></i> Kembali
                </button>
              </div>

              <!-- Topik & Kendala Info -->
              <div class="bg-base-200/60 p-4 rounded-xl border border-base-300">
                <h3 class="text-base md:text-lg font-bold text-base-content">
                  <%= topic.kendala %> 
                  <span class="badge badge-primary badge-outline ml-2"><%= topic.topic %></span>
                </h3>
              </div>

              <!-- Desktop Table View -->
              <div class="hidden md:block overflow-x-auto w-full">
                <table class="table table-zebra w-full text-left border-collapse">
                  <thead>
                    <tr class="bg-base-200/60 text-xs font-bold text-base-content/70 uppercase tracking-wider">
                      <th style="width: 10px">#</th>
                      <th>Tanggal</th>
                      <th>Nama</th>
                      <th>Keterangan</th>
                      <th style="width: 130px">Status</th>
                    </tr>
                  </thead>
                  <tbody id="table-desktop" class="text-sm">
                    <!-- Dimuat secara dinamis via tiket.js -->
                  </tbody>
                </table>
              </div>

              <!-- Mobile Card View -->
              <div id="cards-mobile" class="md:hidden space-y-3">
                <!-- Dimuat secara dinamis via tiket.js -->
              </div>

            </div>
          </div>

          <!-- Card 2: Update Status Form -->
          <div class="card bg-base-100 shadow-xl border border-base-200">
            <div class="card-body p-5 md:p-6">
              <h2 class="card-title text-success border-b border-base-200 pb-3 mb-4">
                <i class="fas fa-edit mr-2"></i> Update Status Tiket
              </h2>
              
              <form id="updateTiket" class="space-y-4">
                
                <!-- Pilih Status -->
                <div class="form-control w-full">
                  <label class="label" for="status">
                    <span class="label-text font-semibold">Pilih Status Baru</span>
                  </label>
                  <select id="status" name="status" class="select select-bordered w-full hover:border-success focus:border-success transition-colors" required>
                    <option value="" disabled selected>Pilih Status</option>
                    <option value="Proses">Proses</option>
                    <option value="Selesai">Selesai</option>
                    <option value="Tutup">Tutup</option>
                  </select>
                </div>

                <!-- Catatan -->
                <div class="form-control w-full">
                  <label class="label" for="notes">
                    <span class="label-text font-semibold">Catatan / Keterangan Tambahan</span>
                  </label>
                  <textarea id="notes" name="notes" rows="4" class="textarea textarea-bordered h-32 w-full hover:border-success focus:border-success transition-colors" placeholder="Masukkan catatan penanganan atau solusi kendala..."></textarea>
                </div>

                <!-- Action Button -->
                <div class="flex justify-start pt-4 border-t border-base-200">
                  <button type="submit" id="fsubmit" class="btn btn-success w-full sm:w-auto text-white gap-2">
                    <i class="fas fa-save"></i> Simpan Pembaharuan
                  </button>
                </div>

              </form>
            </div>
          </div>

        </div>
      </main>

      <!-- Footer -->
      <footer class="footer footer-center p-4 bg-base-100 text-base-content border-t border-base-300 mt-auto">
        <aside>
          <p>Copyright © <%= new Date().getFullYear() %> RSUD dr. Abdul Aziz</p>
        </aside>
      </footer>
    </div>

    <!-- Sidebar Utama -->
    <%- include('../template/sidebar'); %>
  </div>

  <!-- Footer Scripts -->
  <%- include('../template/footer'); %>
  <script src="/asset/js/admin/tiket.js"></script>
</body>

</html>