<!DOCTYPE html>
<html lang="id">
    <head>
        <%- include('../template/head'); %>

        <link rel="stylesheet" href="/asset/css/doc.css">
        <link rel="stylesheet" href="/asset/css/tailwind-animations.css">
      <!-- <script src="https://cdn.tailwindcss.com"></script> -->
    </head>
    <body class="hold-transition sidebar-mini layout-fixed">
        
                   
        <div class="wrapper">
            
            <!-- Main Sidebar Container -->
              <!-- Navbar -->
                    <%- include('../template/navbar'); %>
                    <!-- /.navbar -->
            <%- include('../template/sidebar'); %>

            <!-- Content Wrapper. Contains page content -->
            <div class="content-wrapper">
                <!-- Content Header (Page header) -->
                <%- include('../template/content-header'); %>
                <!-- /.content-header -->

                <!-- Main content -->
                <!-- Main content -->
                <section class="content">
                    <div class="container-fluid">
                        <!-- Document Completeness Overview -->
                        <div class="row">
                            <div class="col-12">
                                <div class="completeness-card">
                                    <div class="row align-items-center">
                                        <div class="col-md-8">
                                            <h4><i
                                                    class="fas fa-chart-pie mr-2"></i>Status
                                                Kelengkapan Dokumen</h4>
                                            <p class="mb-0" id="namaPegawai"><%= akun.nama %></p>
                                        </div>
                                    </div>
                                </div>
                            </div>
                        </div>

                        <!-- Quick Actions -->
                        <div class="row">
                             <div class="bg-white rounded-xl border border-gray-200 shadow-sm overflow-hidden">
        
                                <!-- Header Tabel (Hanya tampil di Desktop/Tablet md:up) -->
                                <div class="hidden md:grid grid-cols-12 gap-4 p-4 bg-gray-50 border-b border-gray-200 text-xs font-bold text-gray-500 uppercase tracking-wider">
                                    <div class="col-span-3 lg:col-span-2">Dokumen</div>
                                    <div class="col-span-5 lg:col-span-6">Detail Informasi</div>
                                    <div class="col-span-2 lg:col-span-2 text-center">Aksi</div>
                                </div>

                                <!-- Tempat di mana baris dokumen akan dirender oleh JavaScript -->
                                <div id="document-grid" class="divide-y divide-gray-100">
                                    <!-- Konten diisi via JS -->
                                </div>

                            </div>
                        </div>
                    </div>
                </section>
                <section 
                    class="content">
                    <div class="container-fluid">
                       
                    </div>

                </section>
                <!-- /.content -->
            </div>
            <!-- /.content-wrapper -->
            <footer class="main-footer">

            </footer>

        </div>
    
        <!-- ./wrapper -->

        <%- include('../template/footer'); %>
        <script src="/asset/js/admin/doc2.js"></script>
    </body>
</html>