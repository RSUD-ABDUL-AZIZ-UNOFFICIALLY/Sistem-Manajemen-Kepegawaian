<!DOCTYPE html>
<html lang="id" data-theme="light">

<head>
  <%- include('../template/head'); %>
  <meta name="description" content="Formulir Pengajuan Cuti Pegawai RSUD dr. Abdul Aziz Singkawang">
  <link rel="stylesheet" type="text/css" href="https://cdn.jsdelivr.net/npm/daterangepicker/daterangepicker.css" />
</head>

<body class="bg-base-200 text-base-content font-sans antialiased">
  <!-- Wrapper Utama Drawer DaisyUI -->
  <div class="drawer lg:drawer-open">
    <input id="main-drawer" type="checkbox" class="drawer-toggle" />
    
    <!-- Konten Utama -->
    <div class="drawer-content flex flex-col min-h-screen">
      
      <!-- Navbar -->
      <%- include('../template/navbar'); %>

      <!-- Content Header -->
      <header class="w-full p-4 md:p-6 pb-2">
        <div class="flex flex-col md:flex-row md:items-center justify-between gap-4">
          <div>
            <h1 class="text-2xl font-bold tracking-tight">Formulir Pengajuan Cuti</h1>
          </div>
          <div class="breadcrumbs text-sm">
            <ul>
              <li><a href="/">Home</a></li>
              <li class="font-semibold">Pengajuan Cuti</li>
            </ul>
          </div>
        </div>
      </header>

      <!-- Main content -->
      <main class="flex-1 p-4 md:p-6">
        <div class="container mx-auto max-w-4xl space-y-6">
          
          <!-- Card Formulir -->
          <div class="card bg-base-100 shadow-xl border border-base-200">
            <div class="card-body p-5 md:p-6 space-y-4">
              
              <h2 class="card-title text-base md:text-lg font-bold text-primary border-b border-base-200 pb-3">
                <i class="fas fa-file-signature mr-2"></i> Form Input Pengajuan Cuti Pegawai
              </h2>

              <form id="Cuti" class="space-y-4">
                
                <!-- Cari Pegawai -->
                <div class="form-control w-full">
                  <label class="label" for="findID">
                    <span class="label-text font-semibold">Cari Pegawai</span>
                  </label>
                  <div class="join w-full">
                    <input 
                      type="text" 
                      id="findID" 
                      name="findID" 
                      class="input input-bordered join-item w-full hover:border-primary focus:border-primary transition-colors text-sm" 
                      placeholder="Cari Nama / NIK / NIP / No WA" 
                    />
                    <button class="btn btn-info join-item text-white gap-1" type="button" id="button-findID">
                      <i class="fa-solid fa-magnifying-glass"></i> Cari
                    </button>
                  </div>
                </div>

                <!-- Grid Data Pegawai (Readonly/Disabled) -->
                <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
                  <div class="form-control w-full">
                    <label class="label"><span class="label-text font-semibold">Nama</span></label>
                    <input type="text" id="nama" class="input input-bordered w-full bg-base-200" placeholder="Nama Pegawai" disabled required />
                  </div>
                  <div class="form-control w-full">
                    <label class="label"><span class="label-text font-semibold">NIK</span></label>
                    <input type="text" id="nik" class="input input-bordered w-full bg-base-200" placeholder="NIK" disabled required />
                  </div>
                  <div class="form-control w-full">
                    <label class="label"><span class="label-text font-semibold">No WA</span></label>
                    <input type="text" id="noWA" class="input input-bordered w-full bg-base-200" placeholder="Nomor WhatsApp" disabled required />
                  </div>
                  <div class="form-control w-full">
                    <label class="label"><span class="label-text font-semibold">Unit Kerja</span></label>
                    <input type="text" id="departemen" class="input input-bordered w-full bg-base-200" placeholder="Unit Kerja / Departemen" disabled required />
                  </div>
                </div>

                <!-- Jenis Cuti -->
                <div class="form-control w-full">
                  <label class="label" for="jnsCuti">
                    <span class="label-text font-semibold">Jenis Cuti</span>
                  </label>
                  <select id="jnsCuti" class="select select-bordered w-full hover:border-primary focus:border-primary transition-colors" disabled>
                    <option value="" disabled selected>Pilih Jenis Cuti</option>
                  </select>
                </div>

                <!-- Rentang Tanggal & Jumlah Hari -->
                <div class="form-control w-full">
                  <label class="label"><span class="label-text font-semibold">Pilih Tanggal Pengajuan Cuti</span></label>
                  <div class="grid grid-cols-1 md:grid-cols-12 gap-3">
                    <div class="md:col-span-8">
                      <div class="join w-full">
                        <span class="btn btn-active join-item pointer-events-none">
                          <i class="far fa-calendar-alt"></i>
                        </span>
                        <input type="text" id="reservation" class="input input-bordered join-item w-full hover:border-primary focus:border-primary transition-colors" placeholder="DD/MM/YYYY - DD/MM/YYYY" required disabled />
                      </div>
                    </div>
                    <div class="md:col-span-4">
                      <div class="join w-full">
                        <input type="number" id="totalReservation" class="input input-bordered join-item w-full text-center font-bold" placeholder="0" required disabled />
                        <span class="btn btn-active join-item pointer-events-none">Hari</span>
                      </div>
                    </div>
                  </div>
                </div>

                <!-- Alasan Cuti -->
                <div class="form-control w-full">
                  <label class="label" for="alasanCuti"><span class="label-text font-semibold">Alasan Cuti</span></label>
                  <textarea id="alasanCuti" rows="3" class="textarea textarea-bordered w-full hover:border-primary focus:border-primary transition-colors" placeholder="Contoh: 'Pulang Kampung'" required autocomplete="on"></textarea>
                </div>

                <!-- Alamat Selama Cuti -->
                <div class="form-control w-full">
                  <label class="label" for="alamat"><span class="label-text font-semibold">Alamat Selama Cuti</span></label>
                  <textarea id="alamat" rows="3" class="textarea textarea-bordered w-full hover:border-primary focus:border-primary transition-colors" placeholder="Contoh: 'Jl. Dr. Sutomo No.28, Singkawang'" required autocomplete="on"></textarea>
                </div>

                <!-- Dynamic Lampiran -->
                <div id="lampiran" class="form-control w-full space-y-2"></div>

                <!-- Keterangan Cuti Info Box -->
                <div class="bg-base-200/60 p-3 rounded-lg border border-base-300">
                  <p class="text-xs text-base-content/80 flex items-start gap-2">
                    <i class="fas fa-info-circle text-info mt-0.5"></i>
                    <span id="Keterangan_cuti">Cari pegawai dan pilih jenis cuti untuk melihat detail ketentuan maksimal hari.</span>
                  </p>
                </div>

                <!-- Submit Button -->
                <div class="flex justify-end pt-4 border-t border-base-200">
                  <button type="submit" id="btnSubmit" class="btn btn-primary w-full sm:w-auto gap-2 text-white">
                    <i class="fas fa-paper-plane"></i> Ajukan Cuti
                  </button>
                </div>

              </form>

            </div>
          </div>

        </div>
      </main>
      
      <!-- Footer -->
      <footer class="footer footer-center p-4 bg-base-100 text-base-content border-t border-base-300 mt-auto">
        <aside>
          <p>Copyright © <%= new Date().getFullYear() %> RSUD dr. Abdul Aziz</p>
        </aside>
      </footer>
    </div>

    <!-- Sidebar Utama -->
    <%- include('../template/sidebar'); %>
  </div>

  <!-- Footer Scripts -->
  <%- include('../template/footer'); %>
  <script type="text/javascript" src="https://cdn.jsdelivr.net/jquery/latest/jquery.min.js"></script>
  <script type="text/javascript" src="https://cdn.jsdelivr.net/momentjs/latest/moment.min.js"></script>
  <script type="text/javascript" src="https://cdn.jsdelivr.net/npm/daterangepicker/daterangepicker.min.js"></script>
  <script src="/asset/js/admin/cuti.js"></script>
</body>

</html>