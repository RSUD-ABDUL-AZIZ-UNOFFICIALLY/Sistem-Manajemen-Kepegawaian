<!DOCTYPE html>
<html lang="id" data-theme="light">
<head>
    <%- include('template/head'); %>
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700&display=swap" rel="stylesheet">
</head>

<body class="bg-base-200 text-base-content font-sans antialiased">
    <!-- Wrapper Utama Drawer DaisyUI -->
    <div class="drawer lg:drawer-open">
        <input id="main-drawer" type="checkbox" class="drawer-toggle" />
        
        <!-- Konten Utama -->
        <div class="drawer-content flex flex-col min-h-screen">
            
            <!-- Navbar -->
            <%- include('template/navbar'); %>

            <!-- Content Header -->
            <header class="w-full p-4 md:p-6 pb-2">
                <div class="flex flex-col md:flex-row md:items-center justify-between gap-4">
                    <div>
                        <h1 class="text-2xl font-bold tracking-tight text-base-content flex items-center gap-3">
                            Laporan Kinerja
                            <span id="status" class="badge badge-neutral text-xs font-semibold py-3 px-3 transition-colors">Memuat...</span>
                        </h1>
                        <p class="text-sm text-base-content/70 mt-1">Kelola rincian aktivitas dan capaian kinerja bulanan.</p>
                    </div>
                    
                    <!-- Filter Tanggal -->
                    <div class="flex items-center gap-3 w-full md:w-auto">
                        <label for="InputTanggal" class="text-sm font-medium text-base-content/70 whitespace-nowrap">Periode:</label>
                        <input type="month" id="InputTanggal" class="input input-bordered w-full md:w-auto bg-base-100 hover:border-primary focus:border-primary transition-colors" value="2026-08">
                    </div>
                </div>
            </header>

            <!-- Main content -->
            <main class="flex-1 p-4 md:p-6 space-y-6">
                
                <!-- Data Table Section -->
                <section class="card bg-base-100 shadow-sm border border-base-200">
                    <div class="card-body p-0">
                        <div class="p-5 border-b border-base-200 flex justify-between items-center">
                            <h2 class="text-lg font-semibold text-base-content">Daftar Aktivitas</h2>
                            <!-- Loader DaisyUI -->
                            <div id="loadingIndicator" class="hidden items-center gap-2 text-primary text-sm font-medium">
                                <span class="loading loading-spinner loading-sm"></span> Loading...
                            </div>
                        </div>
                        
                        <!-- Desktop Table -->
                        <div class="hidden md:block overflow-x-auto w-full">
                            <table class="table table-zebra w-full">
                                <thead class="bg-base-200/50 text-base-content">
                                    <tr>
                                        <th class="w-16 text-center">No</th>
                                        <th>Tanggal</th>
                                        <th>Rincian Kegiatan (RAK)</th>
                                        <th class="text-center">Volume</th>
                                        <th class="text-center">Satuan</th>
                                        <th class="text-center">Waktu (Menit)</th>
                                        <th class="text-center w-32">Aksi</th>
                                    </tr>
                                </thead>
                                <tbody id="tableBody" class="transition-opacity duration-300">
                                    <!-- Data disuntikkan via JS -->
                                </tbody>
                            </table>
                        </div>

                        <!-- Mobile Card List -->
                        <div id="mobileCardList" class="md:hidden divide-y divide-base-200 transition-opacity duration-300">
                            <!-- Data disuntikkan via JS -->
                        </div>
                    </div>
                </section>

                <!-- Summary Section -->
                <section class="card bg-base-100 shadow-sm border border-base-200">
                    <div class="card-body">
                        <h2 class="card-title text-lg border-b border-base-200 pb-3 mb-4">
                            <i class="fas fa-chart-pie text-primary"></i> Ringkasan Produktivitas
                        </h2>
                        
                        <!-- Tempat data dinamis dari API disuntikkan -->
                        <div id="summary" class="transition-all duration-300">
                            <div class="text-center py-8 text-base-content/50 text-sm">Menghitung kalkulasi rekap...</div>
                        </div>
                    </div>
                </section>
                
            </main>
            
            <!-- Footer -->
            <footer class="footer footer-center p-4 bg-base-100 text-base-content border-t border-base-300 mt-auto">
                <aside>
                    <p>Copyright © <%= new Date().getFullYear() %> - RSUD dr. Abdul Aziz</p>
                </aside>
            </footer>
        </div>

        <!-- Sidebar Utama -->
        <%- include('template/sidebar'); %>
    </div>

    <!-- Modal Edit Activity -->
    <%- include('modal/modalMonthly2'); %> 

    <%- include('template/footer'); %>
    <script src="/asset/js/monthly2.js"></script>
</body>
</html>