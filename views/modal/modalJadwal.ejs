<!-- Modal Jadwal DNS menggunakan DaisyUI -->
<dialog id="jadwalDNSModalModern" class="modal modal-bottom sm:modal-middle">
    <div class="modal-box bg-base-100 max-w-2xl">
        <!-- Tombol silang bawaan DaisyUI -->
        <form method="dialog">
            <button class="btn btn-sm btn-circle btn-ghost absolute right-2 top-2">✕</button>
        </form>
        
        <h3 class="font-bold text-lg border-b border-base-200 pb-3 mb-4 text-primary" id="jadwalDNSModalModernLabel">
            🗓️ Jadwal DNS <span id="jadwalPeriode"></span>
        </h3>
        
        <p class="text-sm text-base-content/70 mb-4">
            Geser ke bawah untuk melihat keseluruhan jadwal. Warna pada kartu menunjukkan shift Anda:
        </p>

        <!-- Keterangan Badge -->
        <div class="flex flex-wrap gap-2 mb-6" id="shift-list">
            <span class="badge badge-success text-white shadow-sm">Pagi</span>
            <span class="badge badge-warning text-white shadow-sm">Sore</span>
            <span class="badge badge-error text-white shadow-sm">Malam</span>
        </div>

        <!-- Area List Jadwal (Di-replace dinamis oleh JS) -->
        <div id="jadwal-list" class="space-y-3 max-h-[50vh] overflow-y-auto pr-2 custom-scrollbar">
           
            <!-- DUMMY DATA: Sesuai struktur lama, nantinya di render oleh JS Anda -->
            <div class="card bg-base-100 shadow-sm border border-base-200 shift-1">
                <div class="card-body p-4">
                    <div class="flex flex-col sm:flex-row justify-between items-start sm:items-center gap-2">
                        <div> 
                            <p class="mb-0 font-bold text-base-content">1 November</p>
                        </div>
                        <div class="flex items-center gap-2"> 
                            <span class="badge badge-success text-white">Pagi</span>
                            <span class="text-base-content/60 text-sm font-medium">(06:00 - 12:00)</span> 
                        </div>
                    </div>
                </div>
            </div>

            <div class="card bg-base-100 shadow-sm border border-base-200 shift-1">
                <div class="card-body p-4">
                    <div class="flex flex-col sm:flex-row justify-between items-start sm:items-center gap-2">
                        <div> 
                            <p class="mb-0 font-bold text-base-content">2 November</p>
                        </div>
                        <div class="flex items-center gap-2"> 
                            <span class="badge badge-success text-white">Pagi</span>
                            <span class="text-base-content/60 text-sm font-medium">(06:00 - 12:00)</span> 
                        </div>
                    </div>
                </div>
            </div>

        </div>

        <!-- Modal Footer -->
        <div class="modal-action mt-6 border-t border-base-200 pt-4">
            <form method="dialog">
                <button class="btn btn-outline px-6">Tutup</button>
            </form>
        </div>
    </div>
    
    <!-- Backdrop: Memungkinkan klik di luar modal untuk menutupnya -->
    <form method="dialog" class="modal-backdrop">
        <button>close</button>
    </form>
</dialog>