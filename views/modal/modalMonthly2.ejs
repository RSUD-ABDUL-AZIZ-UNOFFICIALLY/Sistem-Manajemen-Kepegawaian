<!-- Modal DaisyUI (Menggunakan tag <dialog>) -->
<dialog id="exampleModal" class="modal modal-bottom sm:modal-middle">
    <div class="modal-box bg-base-100">
        <!-- Tombol silang di sudut kanan atas -->
        <form method="dialog">
            <button class="btn btn-sm btn-circle btn-ghost absolute right-2 top-2">✕</button>
        </form>
        
        <h3 class="font-bold text-lg border-b border-base-200 pb-3 mb-5">Sunting Aktivitas</h3>
        
        <form id="UpdateProgress" class="space-y-4">
            <input type="hidden" id="InputId">
            
            <div class="form-control w-full">
                <label class="label"><span class="label-text font-medium">Tanggal</span></label>
                <input type="date" id="InputTgl" required class="input input-bordered w-full bg-base-200" readonly>
            </div>
            
            <div class="form-control w-full">
                <label class="label"><span class="label-text font-medium">Rincian Kegiatan (RAK)</span></label>
                <textarea id="InputActivities" required rows="3" class="textarea textarea-bordered w-full hover:border-primary focus:border-primary"></textarea>
            </div>

            <div class="grid grid-cols-2 gap-4">
                <div class="form-control w-full">
                    <label class="label"><span class="label-text font-medium">Volume</span></label>
                    <input type="number" id="InputVolume" required min="1" class="input input-bordered w-full hover:border-primary focus:border-primary">
                </div>
                <div class="form-control w-full">
                    <label class="label"><span class="label-text font-medium">Satuan</span></label>
                    <input type="text" id="InputUnit" required class="input input-bordered w-full hover:border-primary focus:border-primary">
                </div>
            </div>

            <div class="form-control w-full">
                <label class="label"><span class="label-text font-medium">Waktu Penyelesaian (Menit)</span></label>
                <input type="number" id="InputCompletion" required min="1" class="input input-bordered w-full hover:border-primary focus:border-primary">
            </div>
        </form>
        
        <!-- Modal Footer -->
        <div class="modal-action mt-6 border-t border-base-200 pt-5">
            <form method="dialog">
                <button class="btn btn-outline">Batal</button>
            </form>
            <button type="button" onclick="submitEditForm()" class="btn btn-primary shadow-sm text-white">
                <i class="fas fa-save mr-1"></i> Simpan Perubahan
            </button>
        </div>
    </div>
    
    <!-- Backdrop untuk klik di luar -->
    <form method="dialog" class="modal-backdrop">
        <button>close</button>
    </form>
</dialog>