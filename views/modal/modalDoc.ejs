                            <div>
                                <label class="block text-sm font-medium text-gray-700 mb-1">Tanggal Mulai</label>
                                <input type="date" class="w-full rounded-lg border-gray-300 border px-3 py-2 focus:ring-indigo-500 focus:border-indigo-500 sm:text-sm" name="contract_start">
                            </div>
                            <div>
                                <label class="block text-sm font-medium text-gray-700 mb-1">Tanggal Berakhir</label>
                                <input type="date" class="w-full rounded-lg border-gray-300 border px-3 py-2 focus:ring-indigo-500 focus:border-indigo-500 sm:text-sm" name="contract_end">
                            </div>
                        </div>
                        <div>
                            <label class="block text-sm font-medium text-gray-700 mb-1">Jabatan</label>
                            <input type="text" class="w-full rounded-lg border-gray-300 border px-3 py-2 focus:ring-indigo-500 focus:border-indigo-500 sm:text-sm" name="position" placeholder="Jabatan dalam kontrak">
                        </div>
                    </div>

                    <!-- Lainnya Fields -->
                    <div id="lainnya-fields" class="form-section  space-y-4">
                        <div>
                            <label class="block text-sm font-medium text-gray-700 mb-1">Nama Dokumen</label>
                            <input type="text" class="w-full rounded-lg border-gray-300 border px-3 py-2 focus:ring-indigo-500 focus:border-indigo-500 sm:text-sm" name="document_name" placeholder="Nama dokumen">
                        </div>
                        <div>
                            <label class="block text-sm font-medium text-gray-700 mb-1">Deskripsi</label>
                            <textarea class="w-full rounded-lg border-gray-300 border px-3 py-2 focus:ring-indigo-500 focus:border-indigo-500 sm:text-sm" name="other_description" rows="3" placeholder="Deskripsi dokumen"></textarea>
                        </div>
                        <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
                            <div>
                                <label class="block text-sm font-medium text-gray-700 mb-1">Tanggal Dokumen</label>
                                <input type="date" class="w-full rounded-lg border-gray-300 border px-3 py-2 focus:ring-indigo-500 focus:border-indigo-500 sm:text-sm" name="document_date">
                            </div>
                            <div>
                                <label class="block text-sm font-medium text-gray-700 mb-1">Penerbit</label>
                                <input type="text" class="w-full rounded-lg border-gray-300 border px-3 py-2 focus:ring-indigo-500 focus:border-indigo-500 sm:text-sm" name="document_issuer" placeholder="Penerbit dokumen">
                            </div>
                        </div>
                    </div>

                    <!-- General Notes -->
                    <div class="border-t border-gray-100 pt-4 mt-4">
                        <label class="block text-sm font-medium text-gray-700 mb-1">Catatan Tambahan</label>
                        <textarea class="w-full rounded-lg border-gray-300 border px-3 py-2 focus:ring-indigo-500 focus:border-indigo-500 sm:text-sm" name="catatan" id="catatan" rows="2" placeholder="Catatan atau keterangan tambahan (opsional)"></textarea>
                    </div>

                    <!-- File Upload Section -->
                    <div class="border-t border-gray-100 pt-4 mt-4">
                        <label class="block text-sm font-semibold text-gray-700 mb-3">Upload File <span class="text-red-500">*</span></label>
                        <div class="file-upload-area border-2 border-dashed border-gray-300 rounded-lg p-6 text-center hover:border-indigo-400 hover:bg-indigo-50 transition cursor-pointer" id="modalUploadArea" onclick="document.getElementById('modalFileInput').click()">
                            <svg class="mx-auto h-12 w-12 text-gray-400 pointer-events-none" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M7 16a4 4 0 01-.88-7.903A5 5 0 1115.9 6L16 6a5 5 0 011 9.9M15 13l-3-3m0 0l-3 3m3-3v12"></path></svg>
                            <h6 class="mt-2 text-sm font-medium text-gray-700 pointer-events-none">Drag & Drop file di sini atau klik untuk memilih</h6>
                            <p class="text-xs text-gray-500 mt-1 pointer-events-none">Format: PDF, JPG, PNG, DOC, DOCX (Max: 10MB)</p>
                            <input type="file" id="modalFileInput" class="hidden" accept=".pdf,.jpg,.jpeg,.png,.doc,.docx">
                            <button type="button" class="mt-3 px-4 py-2 bg-indigo-600 text-white text-sm font-medium rounded-lg hover:bg-indigo-700 transition pointer-events-none">
                                <svg class="w-4 h-4 inline mr-2" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 4v16m8-8H4"></path></svg>
                                Pilih File
                            </button>
                        </div>
                        <div class="mt-3 hidden" id="modalSelectedFile">
                            <div class="bg-indigo-50 border border-indigo-200 rounded-lg px-3 py-2 text-sm flex items-center justify-between">
                                <span class="text-indigo-800">
                                    <svg class="w-4 h-4 inline mr-2" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12h6m-6 4h6m2 5H7a2 2 0 01-2-2V5a2 2 0 012-2h5.586a1 1 0 01.707.293l5.414 5.414a1 1 0 01.293.707V19a2 2 0 01-2 2z"></path></svg>
                                    <span id="selectedFileName"></span>
                                </span>
                                <button type="button" class="text-indigo-600 hover:text-indigo-800" onclick="clearModalFile()">
                                    <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12"></path></svg>
                                </button>
                            </div>
                        </div>
                    </div>
                </div>
                
                <!-- Footer Modal (Actions) -->
                <div class="bg-gray-50 px-6 py-4 border-t border-gray-100 sm:flex sm:flex-row-reverse rounded-b-xl gap-3">
                    <button type="submit" class="inline-flex w-full justify-center rounded-lg bg-indigo-600 px-4 py-2 text-sm font-medium text-white shadow-sm hover:bg-indigo-700 focus:outline-none focus:ring-2 focus:ring-indigo-500 focus:ring-offset-2 sm:w-auto transition">
                        <svg class="w-4 h-4 mr-2" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7"></path></svg>
                        Simpan Dokumen
                    </button>
                    <button type="button" onclick="closeAddDocumentModal()" class="mt-3 inline-flex w-full justify-center rounded-lg bg-white px-4 py-2 text-sm font-medium text-gray-700 shadow-sm ring-1 ring-inset ring-gray-300 hover:bg-gray-50 focus:outline-none sm:mt-0 sm:w-auto transition">
                        <svg class="w-4 h-4 mr-2" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12"></path></svg>
                        Batal
                    </button>
                </div>
            </form>
        </div>
    </div>
</div>
