                            <option value="kompetensi">Riwayat Pendidikan dan Kompetensi</option>
                            <option value="str">Surat Tanda Registrasi (STR)</option>
                            <option value="sip">Surat Izin Praktik (SIP)</option>
                            <option value="sk">Surat Keputusan (SK)</option>
                            <option value="sertifikat">Sertifikat Pelatihan</option>
