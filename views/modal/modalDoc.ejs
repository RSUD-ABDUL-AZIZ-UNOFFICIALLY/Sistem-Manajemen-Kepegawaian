                                    <select class="form-control" name="education_level" required>
                                        <option value="">-- Pilih Tingkat --</option>
                                        <option value="SD">SD</option>
                                        <option value="SMP">SMP</option>
                                        <option value="SMA">SMA/SMK</option>
                                        <option value="D1">Diploma I</option>
                                        <option value="D2">Diploma II</option>
                                        <option value="D3">Diploma III</option>
                                        <option value="S1">Sarjana (S1)</option>
                                        <option value="Profesi">Profesi</option>
                                        <option value="S2">Magister (S2)</option>
                                        <option value="S3">Doktor (S3)</option>
                                        <option value="Spesialis">Spesialis</option>
                                    </select>
                                </div>
                            </div>
                            <div class="col-md-6">
                                <div class="form-group">
                                    <label>Jurusan/Program Studi</label>
                                    <input type="text" class="form-control" name="major" placeholder="Contoh: Teknik Informatika">
                                </div>
                            </div>
                        </div>
                        <div class="row">
                            <div class="col-md-6">
                                <div class="form-group">
                                    <label>Nama Institusi  <span class="text-danger">*</span></label>
                                    <input type="text" class="form-control" name="institution" placeholder="Nama Sekolah/Universitas" required>
                                </div>
                            </div>
                            <div class="col-md-6">
                                <div class="form-group">
                                    <label>Tahun Lulus <span class="text-danger">*</span></label>
                                    <input type="date" class="form-control" name="graduation_date" required>
                                </div>
                            </div>
                        </div>
                        <div class="row">
                            <div class="col-md-6">
                                <div class="form-group">
                                    <label>Nomor Ijazah</label>
                                    <input type="text" class="form-control" name="ijazah_number" placeholder="D1123456789">
                                </div>
                            </div>
                            <div class="col-md-6">
                                <div class="form-group">
                                     <label>IPK/Nilai (Opsional)</label>
                                     <input type="number" class="form-control" name="gpa" step="0.01" max="4.00" placeholder="3.50">
                                </div>
                            </div>
                        </div>
                    </div>

                    <!-- STR Fields -->
                    <div id="str-fields" class="form-section">
                        <div class="row">
                            <div class="col-md-6">
                                <div class="form-group">
                                    <label>Nomor STR <span class="text-danger">*</span></label>
                                    <input type="text" class="form-control" name="str_number" placeholder="Nomor STR" required>
                                </div>
                            </div>
                            <div class="col-md-6">
                                <div class="form-group">
                                    <label>Profesi <span class="text-danger">*</span></label>
                                    <select class="form-control" name="profession" required>
                                        <option value="">-- Pilih Profesi --</option>
                                        <option value="Dokter">Dokter</option>
                                        <option value="Dokter Gigi">Dokter Gigi</option>
                                        <option value="Perawat">Perawat</option>
                                        <option value="Perawat Gigi">Perawat Gigi</option>
                                        <option value="Bidan">Bidan</option>
                                        <option value="Apoteker">Apoteker/ Asisten Apoteker</option>
                                        <option value="Ahli Gizi">Ahli Gizi</option>
                                        <option value="Fisioterapis">Fisioterapis</option>
                                        <option value="Rekam Medis">Rekam Medis</option>
                                        <option value="Tenaga Kesehatan Masyarakat">Tenaga Kesehatan Masyarakat</option>
                                        <option value="lainnya">Lainnya</option>
                                    </select>
                                </div>
                            </div>
                        </div>
                        <div class="row">
                            <div class="col-md-6">
                                <div class="form-group">
                                    <label>Tanggal Terbit  <span class="text-danger">*</span></label>
                                    <input type="date" class="form-control" name="issue_date" required>
                                </div>
                            </div>
                            <div class="col-md-6">
                                <div class="form-group">
                                    <label>Tanggal Berakhir</label>
                                    <div class="input-group">
                                        <input type="date" class="form-control" name="expiry_date" placeholder="Tanggal berakhir" id="expiryDate">
                                        <div class="input-group-append">
                                            <button class="btn btn-outline-secondary" onclick="berlakuSeumurHidup()" type="button">Berlaku Seumur Hidup</button>
                                        </div>
                                    </div>
                                </div>
                            </div>
                        </div>
                        <div class="form-group">
                            <label>Penerbit</label>
                            <input type="text" class="form-control" name="issuer" placeholder="Nama Organisasi Penerbit">
                        </div>
                    </div>

                    <!-- kartu Keluarga Fields -->
                    <div id="kk-fields" class="form-section">
                        <div class="form-group">
                            <label>Nomor Kartu Keluarga <span class="text-danger">*</span></label>
                            <input type="text" class="form-control" name="kk_number" placeholder="Nomor Kartu Keluarga" required required-number>
                        </div>
                        <div class="form-group">
                            <label>Nama Kepala Keluarga <span class="text-danger">*</span></label>
                            <input type="text" class="form-control" name="kk_head_name" placeholder="Nama sesuai Kartu Keluarga" required>
                        </div>
                        <div class="form-group">
                            <label>Alamat Kartu Keluarga</label>
                            <textarea class="form-control" name="kk_address" rows="3" placeholder="Alamat sesuai Kartu Keluarga"></textarea>
                        </div>
                        <div class="form-group">
                            <label>Jumlah Anggota Keluarga</label>
                            <input type="number" class="form-control" name="family_members" placeholder="Jumlah anggota keluarga" min="1">
                        </div>
                        <div class="form-group">
                            <label>Tanggal Terbit</label>
                            <input type="date" class="form-control" name="kk_issue_date" placeholder="Tanggal terbit Kartu Keluarga">
                        </div>
                    </div>

                    <!-- KTP Fields -->
                    <div id="ktp-fields" class="form-section">
                        <div class="form-group">
                            <label>NIK <span class="text-danger">*</span></label>
                            <input type="text" class="form-control" name="ktp_number" placeholder="NIK" maxlength="16" required required-number>
                        </div>
                        <div class="form-group">
                            <label>Nama di KTP <span class="text-danger">*</span></label>
                            <input type="text" class="form-control" name="ktp_name" placeholder="NIK" maxlength="16" required required-number>
                        </div>
                        <div class="row">
                            <div class="col-md-6">
                                <div class="form-group">
                                    <label>Tempat Lahir <span class="text-danger">*</span></label>
                                    <input type="text" class="form-control" name="birth_place" placeholder="Kota Kelahiran" required>
                                </div>
                            </div>
                            <div class="col-md-6">
                                <div class="form-group">
                                    <label>Tanggal Lahir <span class="text-danger">*</span></label>
                                    <input type="date" class="form-control" name="birth_date" required>
                                </div>
                            </div>
                            <div class="col-md-6">
                                <div class="form-group">
                                    <label>Tanggal Terbit <span class="text-danger">*</span></label>
                                    <input type="date" class="form-control" name="ktp_issue_date" required>
                                </div>
                            </div>
                        </div>
                        <div class="form-group">
                            <label>Alamat KTP <span class="text-danger">*</span></label>
                            <textarea class="form-control" name="ktp_address" rows="3" placeholder="Alamat lengkap sesuai KTP" required></textarea>
                        </div>
                    </div>

                    <!-- NPWP Fields -->
                    <div id="npwp-fields" class="form-section">
                        <div class="form-group">
                            <label>Nomor NPWP <span class="text-danger">*</span></label>
                            <input type="text" class="form-control" name="npwp_number" placeholder="XX.XXX.XXX.X-XXX.XXX" required>
                        </div>
                        <div class="form-group">
                            <label>Nama Wajib Pajak <span class="text-danger">*</span></label>
                            <input type="text" class="form-control" name="taxpayer_name" placeholder="Nama sesuai NPWP" required>
                        </div>
                    </div>

                    <!-- CV Fields -->
                    <div id="cv-fields" class="form-section">
                        <div class="form-group">
                            <label>Versi CV <span class="text-danger">*</span></label>
                            <input type="text" class="form-control" name="cv_version" placeholder="Contoh: Versi Januari 2024" required>
                        </div>
                        <div class="form-group">
                            <label>Deskripsi Singkat</label>
                            <textarea class="form-control" name="cv_description" rows="3" placeholder="Ringkasan perubahan atau highlight CV"></textarea>
                        </div>
                    </div>

                    <!-- Sertifikat Fields -->
                    <div id="sertifikat-fields" class="form-section">
                        <div class="form-group">
                            <label>Nama Sertifikat <span class="text-danger">*</span></label>
                            <input type="text" class="form-control" name="certificate_name" placeholder="Nama pelatihan/sertifikat" required>
                        </div>
                        <div class="row">
                            <div class="col-md-6">
                                <div class="form-group">
                                    <label>Penyelenggara</label>
                                    <input type="text" class="form-control" name="organizer" placeholder="Nama penyelenggara">
                                </div>
                            </div>
                            <div class="col-md-6">
                                <div class="form-group">
                                    <label>Tanggal Pelatihan <span class="text-danger">*</span></label>
                                    <input type="date" class="form-control" name="training_date" required>
                                </div>
                            </div>
                        </div>
                        <div class="row">
                            <div class="col-md-6">
                                <div class="form-group">
                                    <label>Durasi (Jam)</label>
                                    <input type="number" class="form-control" name="duration" placeholder="Jam pelatihan">
                                </div>
                            </div>
                            <div class="col-md-6">
                                <div class="form-group">
                                    <label>Nomor Sertifikat</label>
                                    <input type="text" class="form-control" name="certificate_number" placeholder="Nomor sertifikat">
                                </div>
                            </div>
                        </div>
                    </div>

                    <!-- SKCK Fields -->
                    <div id="skck-fields" class="form-section">
                        <div class="form-group">
                            <label>Nomor SKCK <span class="text-danger">*</span></label>
                            <input type="text" class="form-control" name="skck_number" placeholder="Nomor SKCK" required>
                        </div>
                        <div class="row">
                            <div class="col-md-6">
                                <div class="form-group">
                                    <label>Penerbit</label>
                                    <select class="form-control" name="skck_issuer">
                                        <option value="">-- Pilih Penerbit --</option>
                                        <option value="polres">Polres</option>
                                        <option value="polda">Polda</option>
                                        <option value="mabes">Mabes Polri</option>
                                    </select>
                                </div>
                            </div>
                            <div class="col-md-6">
                                <div class="form-group">
                                    <label>Tanggal Terbit <span class="text-danger">*</span></label>
                                    <input type="date" class="form-control" name="skck_issue_date" required>
                                </div>
                            </div>
                        </div>
                        <div class="form-group">
                            <label>Keperluan</label>
                            <input type="text" class="form-control" name="skck_purpose" placeholder="Untuk keperluan kerja, dll">
                        </div>
                    </div>

                    <!-- Kontrak Fields -->
                    <div id="kontrak-fields" class="form-section">
                        <div class="form-group">
                            <label>Jenis Kontrak / SK</label>
                            <select class="form-control" name="contract_type">
                                <option value="">-- Pilih Jenis --</option>
                                <option value="pkwt">PKWT (Kontrak)</option>
                                <option value="pppk">PPPK</option>
                            </select>
                        </div>
                        <div class="row">
                            <div class="col-md-6">
                                <div class="form-group">
                                    <label>Tanggal Mulai</label>
                                    <input type="date" class="form-control" name="contract_start">
                                </div>
                            </div>
                            <div class="col-md-6">
                                <div class="form-group">
                                    <label>Tanggal Berakhir</label>
                                    <input type="date" class="form-control" name="contract_end">
                                </div>
                            </div>
                        </div>
                        <div class="form-group">
                            <label>Jabatan</label>
                            <input type="text" class="form-control" name="position" placeholder="Jabatan dalam kontrak">
                        </div>
                    </div>
                    <!-- Pangkat Fields -->
                    <div id="pangkat-fields" class="form-section">
                        <div class="form-group">
                            <label>Pendidikan</label>
                            <input type="text" class="form-control" name="pendidikan" placeholder="D-III Keperawatan">
                        </div>
                        <div class="row">
                            <div class="col-md-6">
                                <div class="form-group">
                                    <label>Pangkat/Gol. Ruang Lama</label>
                                    <input type="text" class="form-control" name="gol_ruang" placeholder="Penata TK I (IV/b)">
                                </div>
                            </div>
                            <div class="col-md-6">
                                <div class="form-group">
                                    <label>TMT Pangkat/Gol. Ruang Lama</label>
                                    <input type="date" class="form-control" name="gol_ruang_tmt">
                                </div>
                            </div>
                        </div>
                        <div class="row">
                            <div class="col-md-6">
                                <div class="form-group">
                                    <label>Jabatan/Angka Kredit</label>
                                    <input type="text" class="form-control" name="jabatan" placeholder="Perawat Peneylia">
                                </div>
                            </div>
                            <div class="col-md-6">
                                <div class="form-group">
                                    <label>TMT Jabatan/Angka Kredit</label>
                                    <input type="date" class="form-control" name="jabatan_tmt">
                                </div>
                            </div>
                        </div>
                        
                        <div class="row">
                            <div class="col-md-6">
                                <div class="form-group">
                                    <label>Tanggal Dokumen</label>
                                    <input type="date" class="form-control" name="document_date">
                                </div>
                            </div>
                            <div class="col-md-6">
                                <div class="form-group">
                                    <label>Pejabat</label>
                                    <input type="text" class="form-control" name="document_issuer" placeholder="Nama Walikota, Bupati, dll">
                                </div>
                            </div>
                        </div>
                    </div>
                    <!-- Lainnya Fields -->
                    <div id="lainnya-fields" class="form-section">
                        <div class="form-group">
                            <label>Nama Dokumen</label>
                            <input type="text" class="form-control" name="document_name" placeholder="Nama dokumen">
                        </div>
                        <div class="form-group">
                            <label>Deskripsi</label>
                            <textarea class="form-control" name="other_description" rows="3" placeholder="Deskripsi dokumen"></textarea>
                        </div>
                        <div class="row">
                            <div class="col-md-6">
                                <div class="form-group">
                                    <label>Tanggal Dokumen</label>
                                    <input type="date" class="form-control" name="document_date">
                                </div>
                            </div>
                            <div class="col-md-6">
                                <div class="form-group">
                                    <label>Penerbit</label>
                                    <input type="text" class="form-control" name="document_issuer" placeholder="Penerbit dokumen">
                                </div>
                            </div>
                        </div>
                    </div>

                    <!-- File Upload Section -->
                    <div class="form-group mt-4">
                        <label>Upload File <span class="text-danger">*</span></label>
                        <div class="file-upload-area" id="modalUploadArea">
                            <i class="fas fa-cloud-upload-alt fa-2x text-primary mb-2"></i>
                            <h6>Drag & Drop file di sini atau klik untuk memilih</h6>
                            <p class="text-muted small">Format: PDF, JPG, PNG, DOC, DOCX (Max: 10MB)</p>
                            <input type="file" id="modalFileInput" class="d-none" accept=".pdf,.jpg,.jpeg,.png,.doc,.docx">
                            <button type="button" class="btn btn-outline-primary btn-sm mt-2" onclick="document.getElementById('modalFileInput').click()">
                                <i class="fas fa-file-plus mr-1"></i>Pilih File
                            </button>
                        </div>
                        <div class="mt-2" id="modalSelectedFile" style="display: none;">
                            <div class="alert alert-info alert-sm mb-0">
                                <i class="fas fa-file mr-2"></i>
                                <span id="selectedFileName"></span>
                                <button type="button" class="close" onclick="clearModalFile()">
                                    <span>&times;</span>
                                </button>
                            </div>
                        </div>
                    </div>

                    <!-- General Notes -->
                    <div class="form-group">
                        <label>Catatan Tambahan</label>
                        <textarea class="form-control" name="catatan" id="catatan" rows="2" placeholder="Catatan atau keterangan tambahan (opsional)"></textarea>
                    </div>
                </form>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">
                    <i class="fas fa-times mr-2"></i>Batal
                </button>
                <button type="submit" class="btn btn-primary" onclick="saveDocument()">
                    <i class="fas fa-save mr-2"></i>Simpan Dokumen
                </button>
            </div>
        </div>
    </div>
</div>
