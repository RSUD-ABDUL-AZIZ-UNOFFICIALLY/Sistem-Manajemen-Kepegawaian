<!DOCTYPE html>
<html lang="id" data-theme="light">
<head>
    <%- include('template/head'); %>
    <meta name="description" content="Manajemen Dokumen Kepegawaian RSUD dr. Abdul Aziz Singkawang">
    <link rel="stylesheet" href="/asset/css/doc.css">
</head>

<body class="bg-base-200 text-base-content font-sans antialiased">
    <!-- Wrapper Utama Drawer DaisyUI -->
    <div class="drawer lg:drawer-open">
        <input id="main-drawer" type="checkbox" class="drawer-toggle" />
        
        <!-- Konten Utama -->
        <div class="drawer-content flex flex-col min-h-screen">
            
            <!-- Navbar -->
            <%- include('template/navbar'); %>

            <!-- Content Header -->
            <header class="w-full p-4 md:p-6 pb-2">
                <div class="flex flex-col md:flex-row md:items-center justify-between gap-4">
                    <div>
                        <h1 class="text-2xl font-bold tracking-tight">Dokumen Saya</h1>
                    </div>
                    <div class="breadcrumbs text-sm">
                        <ul>
                            <li><a href="/">Home</a></li>
                            <li class="font-semibold">Kelengkapan Dokumen</li>
                        </ul>
                    </div>
                </div>
            </header>

            <!-- Main content -->
            <main class="flex-1 p-4 md:p-6">
                <!-- Membatasi lebar kontainer agar rapi di layar besar -->
                <div class="container mx-auto max-w-7xl space-y-6">
                    
                    <!-- Card Overview Status Kelengkapan Dokumen -->
                    <div class="card bg-base-100 shadow-xl border border-base-200 transition-all duration-200 hover:shadow-md">
                        <div class="card-body p-5 md:p-6 flex flex-row items-center gap-4">
                            <div class="p-3 bg-primary/10 text-primary rounded-2xl flex-shrink-0">
                                <i class="fas fa-chart-pie text-2xl md:text-3xl"></i>
                            </div>
                            <div>
                                <h2 class="card-title text-base md:text-lg font-bold text-base-content">Status Kelengkapan Dokumen</h2>
                                <p class="text-xs md:text-sm text-base-content/70 mt-0.5">Lengkapi dokumen wajib untuk menyelesaikan proses administrasi kepegawaian.</p>
                            </div>
                        </div>
                    </div>

                    <!-- Card Quick Action (Tambah Berkas) -->
                    <div class="card bg-base-100 shadow-xl border border-base-200">
                        <div class="card-body p-5 md:p-6 flex flex-col sm:flex-row sm:items-center justify-between gap-4">
                            <div>
                                <h3 class="font-bold text-base text-base-content flex items-center gap-2">
                                    <i class="fas fa-folder-plus text-primary"></i>
                                    Aksi Cepat
                                </h3>
                                <p class="text-xs text-base-content/60 mt-0.5">Unggah berkas baru ke sistem penyimpanan dokumen Anda.</p>
                            </div>
                            <button 
                                type="button" 
                                class="btn btn-primary btn-sm md:btn-md gap-2 shadow-sm"
                                onclick="openAddDocumentModal()">
                                <i class="fas fa-file-plus"></i>
                                Tambah Dokumen Baru
                            </button>
                        </div>
                    </div>

                    <!-- Container Grid / Tabel Dokumen -->
                    <div class="bg-base-100 rounded-2xl border border-base-200 shadow-xl overflow-hidden">
                        
                        <!-- Header Tabel (Hanya tampil di Tablet & Desktop / md:up) -->
                        <div class="hidden md:grid grid-cols-12 gap-4 px-6 py-3.5 bg-base-200/60 border-b border-base-300 text-xs font-bold text-base-content/70 uppercase tracking-wider">
                            <div class="col-span-3 lg:col-span-2">Dokumen</div>
                            <div class="col-span-5 lg:col-span-6">Detail Informasi</div>
                            <div class="col-span-4 lg:col-span-4 text-center">Aksi</div>
                        </div>

                        <!-- Tempat di mana baris dokumen akan dirender oleh JavaScript -->
                        <div id="document-grid" class="divide-y divide-base-200">
                            <!-- Konten diisi via JS -->
                        </div>

                    </div>

                </div>
            </main>
            
            <!-- Footer -->
            <footer class="footer footer-center p-4 bg-base-100 text-base-content border-t border-base-300 mt-auto">
                <aside>
                    <p>Copyright © <%= new Date().getFullYear() %> RSUD dr. Abdul Aziz</p>
                </aside>
            </footer>
        </div>

        <!-- Sidebar Utama -->
        <%- include('template/sidebar'); %>
    </div>

    <!-- Modals & Scripts -->
    <%- include('modal/modalDoc.ejs'); %>
    <%- include('template/footer'); %>
    
    <script src="/asset/js/doc2.js"></script>
    <script src="/asset/js/doc.js"></script>
</body>
</html>