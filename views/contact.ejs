<!DOCTYPE html>
<html lang="id" data-theme="light">

<head>
  <%- include('template/head'); %>
  <meta name="description" content="Kontak Rekan & Tim Pegawai RSUD dr. Abdul Aziz Singkawang">
</head>

<body class="bg-base-200 text-base-content font-sans antialiased">
  <!-- Wrapper Utama Drawer DaisyUI -->
  <div class="drawer lg:drawer-open">
    <input id="main-drawer" type="checkbox" class="drawer-toggle" />
    
    <!-- Konten Utama -->
    <div class="drawer-content flex flex-col min-h-screen">
      
      <!-- Navbar -->
      <%- include('template/navbar'); %>

      <!-- Hero Banner Section -->
      <section class="bg-gradient-to-r from-primary to-secondary text-primary-content py-10 md:py-14 px-4 md:px-6 shadow-md">
        <div class="max-w-4xl mx-auto text-center space-y-2">
          <h1 class="text-3xl md:text-4xl font-extrabold tracking-tight">Hubungi Tim Kami</h1>
          <p class="text-sm md:text-base opacity-90 max-w-xl mx-auto">
            Temukan dan hubungi anggota tim untuk dukungan kerja, komunikasi, atau kolaborasi antar-unit.
          </p>
        </div>
      </section>

      <!-- Main Content -->
      <main class="flex-1 p-4 md:p-6 space-y-6">
        <div class="container mx-auto max-w-7xl space-y-6">
          
          <!-- Search Bar Section -->
          <div class="max-w-2xl mx-auto">
            <div class="relative w-full">
              <input 
                type="search" 
                id="cariRekan" 
                placeholder="🔍 Cari nama, departemen, atau jabatan..." 
                class="input input-bordered input-lg w-full bg-base-100 shadow-md hover:border-primary focus:border-primary transition-colors text-sm md:text-base"
              />
            </div>
          </div>

          <!-- Cards Grid Container -->
          <div id="layout" class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-4 md:gap-6">
            <!-- Cards anggota tim akan dirender di sini secara dinamis via contact2.min.js -->
          </div>

          <!-- Empty State -->
          <div id="emptyState" class="hidden text-center py-16 space-y-3">
            <div class="text-base-content/30">
              <i class="fas fa-search-minus text-6xl"></i>
            </div>
            <h3 class="text-lg font-bold text-base-content/80">Tidak ada hasil yang ditemukan</h3>
            <p class="text-xs md:text-sm text-base-content/60 max-w-sm mx-auto">
              Coba gunakan kata kunci pencarian nama, departemen, atau posisi yang lain.
            </p>
          </div>

        </div>
      </main>

      <!-- Footer -->
      <footer class="footer footer-center p-4 bg-base-100 text-base-content border-t border-base-300 mt-auto">
        <aside>
          <p>Copyright © <%= new Date().getFullYear() %> RSUD dr. Abdul Aziz</p>
        </aside>
      </footer>
    </div>

    <!-- Sidebar Utama -->
    <%- include('template/sidebar'); %>
  </div>

  <!-- Footer Scripts -->
  <%- include('template/footer'); %>
  <script src="/asset/js/contact2.min.js"></script>
</body>

</html>