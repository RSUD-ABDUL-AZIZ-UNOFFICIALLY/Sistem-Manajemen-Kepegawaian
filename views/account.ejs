<!DOCTYPE html>
<html lang="id" data-theme="light">
<head>
    <%- include('template/head'); %>
    <meta name="description" content="Manajemen Akun SIMRS dan Passkey Kepegawaian RSUD dr. Abdul Aziz Singkawang">
</head>

<body class="bg-base-200 text-base-content font-sans antialiased">
    <!-- Wrapper Utama Drawer DaisyUI -->
    <div class="drawer lg:drawer-open">
        <input id="main-drawer" type="checkbox" class="drawer-toggle" />
        
        <!-- Konten Utama -->
        <div class="drawer-content flex flex-col min-h-screen">
            
            <!-- Navbar -->
            <%- include('template/navbar'); %>

            <!-- Content Header -->
            <header class="w-full p-4 md:p-6 pb-2">
                <div class="flex flex-col md:flex-row md:items-center justify-between gap-4">
                    <div>
                        <h1 class="text-2xl font-bold tracking-tight">Akun SIMRS & Passkey</h1>
                    </div>
                    <div class="breadcrumbs text-sm">
                        <ul>
                            <li><a href="/">Home</a></li>
                            <li class="font-semibold">Pengaturan Akun</li>
                        </ul>
                    </div>
                </div>
            </header>

            <!-- Main content -->
            <main class="flex-1 p-4 md:p-6">
                <!-- Membatasi lebar kontainer maksimal 4 agar rapi dan tidak terlalu lebar -->
                <div class="container mx-auto max-w-4xl space-y-6">
                    
                    <!-- Card Akun Pengguna SIMRS -->
                    <div class="card bg-base-100 shadow-xl border border-base-200">
                        <div class="card-body">
                            <h2 class="card-title text-primary border-b border-base-200 pb-3 mb-4">
                                <i class="fas fa-user-shield mr-2"></i> Akun Pengguna SIMRS
                            </h2>
                            
                            <!-- Form Start -->
                            <form id="simrs" enctype="multipart/form-data" class="space-y-4">
                                
                                <!-- User -->
                                <div class="form-control w-full">
                                    <label class="label" for="simrs_User">
                                        <span class="label-text font-semibold">User</span>
                                    </label>
                                    <input type="text" id="simrs_User" name="simrs_User" class="input input-bordered w-full bg-base-200/50 cursor-not-allowed" disabled />
                                </div>
                                
                                <!-- Password -->
                                <div class="form-control w-full">
                                    <label class="label" for="simrs_Password">
                                        <span class="label-text font-semibold">Password</span>
                                    </label>
                                    <input type="text" id="simrs_Password" name="simrs_Password" class="input input-bordered w-full bg-base-200/50 cursor-not-allowed" disabled />
                                </div>
                                
                                <p id="simrs_accoun" class="text-sm text-base-content/70 mt-2"></p>
                                
                            </form>
                            <!-- Form End -->
                        </div>
                    </div>

                    <!-- Card Aktivasi Passkey -->
                    <div class="card bg-base-100 shadow-xl border border-base-200">
                        <div class="card-body">
                            <h2 class="card-title text-primary border-b border-base-200 pb-3 mb-4">
                                <i class="fas fa-key mr-2"></i> Aktivasi Passkey
                            </h2>
                            
                            <div id="boddy_passkey" class="space-y-4">
                                <p class="text-success font-medium text-sm" id="passkey_accoun"></p>
                                <div id="main_auth"></div>
                            </div>
                        </div>
                    </div>

                </div>
            </main>
            
            <!-- Footer -->
            <footer class="footer footer-center p-4 bg-base-100 text-base-content border-t border-base-300 mt-auto">
                <aside>
                    <p>Copyright © <%= new Date().getFullYear() %> RSUD dr. Abdul Aziz</p>
                </aside>
            </footer>
        </div>

        <!-- Sidebar Utama -->
        <%- include('template/sidebar'); %>
    </div>

    <!-- Scripts -->
    <%- include('template/footer'); %>
    <script src="/asset/js/simrs.js"></script>
    <script type="text/javascript" src="/asset/js/lib/qrcode.min.js"></script>
    <script src="/asset/js/passkey.js"></script>
</body>
</html>