<!-- Area Drawer Side (Sidebar) -->
<div class="drawer-side z-50">
    <label for="main-drawer" aria-label="close sidebar" class="drawer-overlay"></label> 
    
    <aside class="w-72 min-h-full bg-base-100 text-base-content flex flex-col shadow-xl">
        <!-- Brand Logo -->
        <div class="p-4 flex items-center gap-3 border-b border-base-200">
            <img src="/asset/img/Lambang_KotaSingkawang.webp" alt="Singkawang Logo"
                class="w-10 h-10 rounded-full shadow-sm object-cover opacity-90" />
            <span class="font-semibold text-lg tracking-tight">RSUD dr. Abdul Aziz</span>
        </div>

        <!-- Sidebar user panel -->
        <div class="p-4 flex items-center gap-4 border-b border-base-200">
            <div class="avatar">
                <div class="w-12 h-12 rounded-full ring ring-primary ring-offset-base-100 ring-offset-2 shadow-md">
                    <img src="/asset/img/cowok.png" id="imgUser" alt="User Image" class="object-cover" />
                </div>
            </div>
            <div class="flex-1 min-w-0">
                <a href="/profile" class="block truncate text-sm font-semibold text-base-content hover:text-primary transition-colors">
                    <%= token.nama %>
                </a>
                <span class="text-xs text-base-content/60">Pegawai</span>
            </div>
        </div>

        <!-- Sidebar Menu -->
        <ul class="menu flex-nowrap p-4 w-full gap-1 overflow-y-auto" id="navbar" name="navbar">
            
            <li id="laporan" name="laporan">
                <details>
                    <summary class="font-medium">
                        <i class="fas fa-tachometer-alt w-5 text-center"></i> KINERJA KARYAWAN
                    </summary>
                    <ul id="ul_laporan" name="ul_laporan" class="before:w-[1px]">
                        <li><a href="/daily" class="menu-link"><i class="far fa-circle w-4 text-xs"></i> Laporan Harian</a></li>
                        <li><a href="/monthly" class="menu-link"><i class="far fa-circle w-4 text-xs"></i> Laporan Bulanan</a></li>
                        <li><a href="/Report" class="menu-link"><i class="fas fa-arrow-trend-up w-4 text-xs"></i> Rekapitulasi</a></li>
                    </ul>
                </details>
            </li>

            <li id="absen" name="absen">
                <details>
                    <summary class="font-medium">
                        <i class="fa-solid fa-person-circle-check w-5 text-center"></i> ABSENSI KARYAWAN
                    </summary>
                    <ul id="ul_absen" name="ul_absen" class="before:w-[1px]">
                        <li><a href="/absen" class="menu-link"><i class="fa-solid fa-person-walking-arrow-right w-4 text-xs"></i> Absen</a></li>
                    </ul>
                </details>
            </li>

            <li id="documen" name="documen">
                <details>
                    <summary class="font-medium">
                        <i class="fas fa-folder w-5 text-center"></i> DOKUMEN PEGAWAI
                    </summary>
                    <ul class="before:w-[1px]">
                        <li><a href="/profile" class="menu-link"><i class="fas fa-dna w-4 text-xs"></i> Biodata</a></li>
                        <li><a href="/document" class="menu-link"><i class="fas fa-file w-4 text-xs"></i> Dokumen</a></li>
                        <li><a href="/account" class="menu-link"><i class="fas fa-key w-4 text-xs"></i> Akun</a></li>
                        <li><a href="/salary" class="menu-link"><i class="fas fa-wallet w-4 text-xs"></i> Penghasilan</a></li>
                    </ul>
                </details>
            </li>

            <li id="cuti" name="cuti">
                <details>
                    <summary class="font-medium">
                        <i class="fas fa-calendar-alt w-5 text-center"></i> CUTI
                    </summary>
                    <ul id="ul_cuti" class="before:w-[1px]">
                        <li><a href="/cuti" class="menu-link"><i class="fas fa-bed w-4 text-xs"></i> Permohonan Cuti</a></li>
                    </ul>
                </details>
            </li>

        </ul>
        <!-- /.sidebar-menu -->
    </aside>
</div>