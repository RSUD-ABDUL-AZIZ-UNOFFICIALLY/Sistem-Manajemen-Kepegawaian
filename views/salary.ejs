<!DOCTYPE html>
<html lang="id" data-theme="light">
<head>
    <%- include('template/head'); %>
    <meta name="description" content="Riwayat Data Gaji dan TPP Kepegawaian RSUD dr. Abdul Aziz Singkawang">
</head>

<body class="bg-base-200 text-base-content font-sans antialiased">
    <!-- Wrapper Utama Drawer DaisyUI -->
    <div class="drawer lg:drawer-open">
        <input id="main-drawer" type="checkbox" class="drawer-toggle" />
        
        <!-- Konten Utama -->
        <div class="drawer-content flex flex-col min-h-screen">
            
            <!-- Navbar -->
            <%- include('template/navbar'); %>

            <!-- Content Header -->
            <header class="w-full p-4 md:p-6 pb-2">
                <div class="flex flex-col md:flex-row md:items-center justify-between gap-4">
                    <div>
                        <h1 class="text-2xl font-bold tracking-tight">Riwayat Penghasilan</h1>
                    </div>
                    <div class="breadcrumbs text-sm">
                        <ul>
                            <li><a href="/">Home</a></li>
                            <li class="font-semibold">Gaji & TPP</li>
                        </ul>
                    </div>
                </div>
            </header>

            <!-- Main Content -->
            <main class="flex-1 p-4 md:p-6">
                <div class="container mx-auto max-w-7xl space-y-6">
                    
                    <!-- Card Riwayat Data Gaji -->
                    <div class="card bg-base-100 shadow-xl border border-base-200 overflow-hidden">
                        <div class="card-body p-0">
                            <div class="bg-primary px-6 py-4 border-b border-primary-content/10">
                                <h2 class="card-title text-primary-content text-lg">
                                    <i class="fas fa-money-check-alt mr-2"></i> Riwayat Data Gaji
                                </h2>
                            </div>
                            
                            <div class="overflow-x-auto w-full">
                                <table class="table table-zebra w-full text-left">
                                    <thead>
                                        <tr class="bg-base-200/60 text-sm font-semibold text-base-content/80">
                                            <th>Periode</th>
                                            <th>Gaji Pokok</th>
                                            <th>Total Gaji & Tunjangan</th>
                                            <th>Jumlah Potongan</th>
                                            <th>Jumlah Ditransfer</th>
                                        </tr>
                                    </thead>
                                    <tbody id="table-body-gaji" class="text-sm">
                                        <tr id="loading-row-gaji">
                                            <td colspan="5" class="py-8 text-center text-base-content/60">
                                                <div class="flex items-center justify-center gap-2">
                                                    <span class="loading loading-spinner text-primary loading-md"></span>
                                                    <span>Memuat data gaji...</span>
                                                </div>
                                            </td>
                                        </tr>
                                    </tbody>
                                </table>
                            </div>
                        </div>
                    </div>

                    <!-- Card Riwayat Data TPP -->
                    <div class="card bg-base-100 shadow-xl border border-base-200 overflow-hidden">
                        <div class="card-body p-0">
                            <div class="bg-secondary px-6 py-4 border-b border-secondary-content/10">
                                <h2 class="card-title text-secondary-content text-lg">
                                    <i class="fas fa-hand-holding-usd mr-2"></i> Riwayat Data TPP
                                </h2>
                            </div>
                            
                            <div class="overflow-x-auto w-full">
                                <table class="table table-zebra w-full text-left">
                                    <thead>
                                        <tr class="bg-base-200/60 text-sm font-semibold text-base-content/80">
                                            <th>Periode</th>
                                            <th>TPP Kondisi Kerja</th>
                                            <th>TPP Kelangkaan Profesi</th>
                                            <th>Potongan IWP</th>
                                            <th>Potongan PPh 21</th>
                                            <th>Jumlah Ditransfer</th>
                                        </tr>
                                    </thead>
                                    <tbody id="table-body-tpp" class="text-sm">
                                        <tr id="loading-row-tpp">
                                            <td colspan="6" class="py-8 text-center text-base-content/60">
                                                <div class="flex items-center justify-center gap-2">
                                                    <span class="loading loading-spinner text-secondary loading-md"></span>
                                                    <span>Memuat data TPP...</span>
                                                </div>
                                            </td>
                                        </tr>
                                    </tbody>
                                </table>
                            </div>
                        </div>
                    </div>

                </div>
            </main>

            <!-- Footer -->
            <footer class="footer footer-center p-4 bg-base-100 text-base-content border-t border-base-300 mt-auto">
                <aside>
                    <p>Copyright © <%= new Date().getFullYear() %> RSUD dr. Abdul Aziz</p>
                </aside>
            </footer>
        </div>

        <!-- Sidebar Utama -->
        <%- include('template/sidebar'); %>
    </div>

    <!-- Scripts -->
    <%- include('template/footer'); %>

    <script>
        // Formatter untuk Rupiah
        const formatRupiah = (number) => {
            return new Intl.NumberFormat('id-ID', {
                style: 'currency',
                currency: 'IDR',
                minimumFractionDigits: 0,
                maximumFractionDigits: 0
            }).format(number);
        };

        // Fetch dan render data Gaji
        const fetchSalaryData = async () => {
            const tbody = document.getElementById('table-body-gaji');
            
            try {
                const response = await fetch('/api/salary/gaji');
                
                if (!response.ok) {
                    throw new Error(`HTTP error! status: ${response.status}`);
                }
                
                const data = await response.json();
                tbody.innerHTML = '';

                if (!data || !data.data || data.data.length === 0) {
                    tbody.innerHTML = `
                        <tr>
                            <td colspan="5" class="py-8 text-center text-base-content/60">
                                Tidak ada data yang ditemukan.
                            </td>
                        </tr>
                    `;
                    return;
                }

                const rowsHtml = data.data.map(item => `
                    <tr class="hover">
                        <td class="font-medium">${item.periode}</td>
                        <td>${formatRupiah(item.gaji_pokok)}</td>
                        <td>${formatRupiah(item.jumlah_gaji_dan_tunjangan)}</td>
                        <td class="text-error font-medium">${formatRupiah(item.jumlah_potongan)}</td>
                        <td class="text-success font-semibold">${formatRupiah(item.jumlah_ditransfer)}</td>
                    </tr>
                `).join('');

                tbody.innerHTML = rowsHtml;

            } catch (error) {
                console.error('Error fetching salary data:', error);
                tbody.innerHTML = `
                    <tr>
                        <td colspan="5" class="py-8 text-center text-error">
                            Gagal memuat data gaji. Silakan coba lagi nanti.
                        </td>
                    </tr>
                `;
            }
        };

        // Fetch dan render data TPP
        const fetchTppData = async () => {
            const tbody = document.getElementById('table-body-tpp');
            
            try {
                const response = await fetch('/api/salary/tpp');
                
                if (!response.ok) {
                    throw new Error(`HTTP error! status: ${response.status}`);
                }
                
                const data = await response.json();
                tbody.innerHTML = '';

                if (!data || !data.data || data.data.length === 0) {
                    tbody.innerHTML = `
                        <tr>
                            <td colspan="6" class="py-8 text-center text-base-content/60">
                                Tidak ada data yang ditemukan.
                            </td>
                        </tr>
                    `;
                    return;
                }

                const rowsHtml = data.data.map(item => `
                    <tr class="hover">
                        <td class="font-medium">${item.periode}</td>
                        <td>${formatRupiah(item["TPP Kondisi kerja"])}</td>
                        <td>${formatRupiah(item["TPP Kelangkaan Profesi"])}</td>
                        <td class="text-error font-medium">${formatRupiah(item["Potongan IWP"])}</td>
                        <td class="text-error font-medium">${formatRupiah(item["Potongan PPh 21"])}</td>
                        <td class="text-success font-semibold">${formatRupiah(item["Jumlah Ditransfer"])}</td>
                    </tr>
                `).join('');

                tbody.innerHTML = rowsHtml;

            } catch (error) {
                console.error('Error fetching TPP data:', error);
                tbody.innerHTML = `
                    <tr>
                        <td colspan="6" class="py-8 text-center text-error">
                            Gagal memuat data TPP. Silakan coba lagi nanti.
                        </td>
                    </tr>
                `;
            }
        };

        document.addEventListener("DOMContentLoaded", function() {
            fetchTppData();
            fetchSalaryData();
        });
    </script>
</body>
</html>