<!DOCTYPE html>
<html lang="id">

<head>
  <%- include('template/head'); %>
  <meta name="description" content="Produktivitas kerja Kepegawaian RSUD dr. Abdul Aziz Singkawang">
<style>
/* ===== Select2 Input & Box ===== */
.select2-container .select2-selection--single {
  min-height: 42px;
  padding: 6px 10px;
  border: 1px solid #ced4da;
  border-radius: 8px;
  display: flex;
  align-items: center;
}

/* Teks placeholder / yang dipilih */
.select2-selection__rendered {
  line-height: normal !important;
  display: flex;
  align-items: center;
  font-size: 15px;
  padding-left: 2px;
}

/* Panah dropdown */
.select2-selection__arrow {
  height: 100% !important;
  right: 8px !important;
}

/* Hasil pencarian list */
.select2-results__option {
  padding: 6px 10px;
  display: flex !important;
  align-items: center !important;
  gap: 8px;
  font-size: 15px;
}

/* Foto pegawai */
.select2-results__option img,
.select2-selection__rendered img {
  width: 32px !important;
  height: 32px !important;
  border-radius: 50%;
  object-fit: cover;
}

/* Hover list */
.select2-results__option--highlighted {
  background-color: #007bff !important;
  color: white !important;
}

/* Option terpilih */
.select2-results__option--selected {
  background-color: #eef4ff !important;
  color: #000 !important;
}

/* ===== RESPONSIVE (Mobile Optimization) ===== */
@media (max-width: 576px) {

  .select2-container .select2-selection--single {
    min-height: 38px;
    padding: 4px 8px;
  }

  .select2-selection__rendered {
    font-size: 14px;
  }

  .select2-results__option {
    font-size: 14px;
    padding: 5px 8px;
  }

  .select2-results__option img,
  .select2-selection__rendered img {
    width: 26px !important;
    height: 26px !important;
  }

  /* Modal text size scaling */
  .modal-body p,
  .list-group-item {
    font-size: 14px !important;
  }
  .select2-container--open .select2-dropdown {
    left: 0 !important;
    width: 100vw !important;
    right: 0 !important;
    top: 0 !important;
    bottom: 0 !important;
    border-radius: 0 !important;
    position: fixed !important;
    margin: 0 !important;
    height: 100vh !important;
    z-index: 200000 !important;
  }

  /* Input search terlihat seperti header */
  .select2-search--dropdown .select2-search__field {
    font-size: 18px;
    padding: 14px;
  }

  .select2-results__options {
    max-height: calc(100vh - 60px) !important;
  }
.modal.show .select2-container {
  z-index: 200000 !important;
}
}



</style>
<link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.1/font/bootstrap-icons.css">

</head>

<body class="hold-transition sidebar-mini layout-fixed">
  <div class="wrapper">
    <!-- Navbar -->
    <%- include('template/navbar'); %>
      <!-- /.navbar -->

      <!-- Main Sidebar Container -->
      <%- include('template/sidebar'); %>

        <!-- Content Wrapper. Contains page content -->
        <div class="content-wrapper">
          <!-- Content Header (Page header) -->
          <%- include('template/content-header'); %>
            <!-- /.content-header -->

            <!-- Main content -->
            <section class="content">
              <div class="container-fluid">
                <div class="card card-primary">
                  <div class="card-header">
                    <h3 class="card-title">Produktivitas kerja</h3>
                  </div>
                  <!-- /.card-header -->
                  <!-- form start -->
                  <form id="Progress" class="form-horizontal">
                    <div class="card-body">
                      <div class="form-group">
                        <label for="InputTanggal">Tanggal</label>
                        <input type="date" class="form-control" id="Tanggal" value="<%= datenow %>" required />
                      </div>
                      <div class="form-group">
                        <label for="InputActivities">Rincian Kegiatan Kerja/Tugas</label>

                        <textarea class="form-control" rows="3" id="InputActivities"
                          placeholder="contoh 'Hand Over pasien' " required autocomplete="on"></textarea>
                      </div>
                      <div class="form-group">
                        <label for="InputVolume">Volume Aktivitas</label>
                        <input type="number" class="form-control" id="InputVolume" placeholder="Banyak aktivitas"
                          required />
                      </div>
                      <div class="form-group">
                        <label for="Unit">Satuan Kegiatan</label>
                        <select class="custom-select form-control" id="Unit">
                          <option value="-">-</option>
                          <option value="Dokumen">Dokumen</option>
                          <option value="Laporan">Laporan</option>
                          <option value="Kegiatan">Kegiatan</option>
                          <option value="Pasien">Pasien</option>
                          <option value="Resep">Resep</option>
                          <option value="Tindakan">Tindakan</option>
                        </select>
                      </div>
                      <div class="form-group">
                        <label for="InputCompletion">Waktu penyelesaian</label>
                        <div class="input-group mb-3">
                          <input type="number" class="form-control" id="InputCompletion"
                            placeholder="Total waktu penyelesaian kerja" required />
                          <div class="input-group-append">
                            <span class="input-group-text"> Menit</span>
                          </div>
                        </div>
                      </div>
                    </div>
                    <!-- /.card-body -->

                    <div class="card-footer">
                      <button type="submit" class="btn btn-primary">Simpan</button>
                      <button type="button" class="btn btn-info float-right" style="margin-right: 5px"
                        onclick="lihat()">
                        <i class="fa-solid fa-note-sticky"></i> Lihat Template
                      </button>
                      <button type="button" class="btn btn-success float-right" style="margin-right: 5px"
                        onclick="simpan()">
                        <i class="fa-solid fa-file-circle-plus"></i> Simpan Template
                      </button>
                    </div>
                  </form>
                </div>
              </div>
              <!-- /.container-fluid -->
            </section>
            <!-- /.content -->
        </div>
        <!-- /.content-wrapper -->
        <footer class="main-footer"></footer>
  </div>
  <!-- ./wrapper -->
  <%- include('modal/modalTemplate'); %> 
  <%- include('modal/modalVote'); %> 
  <%- include('template/footer'); %>

      <script src="/asset/js/src/daily.min.js"></script>
      <script src="/asset/js/src/template.min.js"></script>
      <link href="https://cdn.jsdelivr.net/npm/select2@4.1.0/dist/css/select2.min.css" rel="stylesheet" />
<script src="https://cdn.jsdelivr.net/npm/select2@4.1.0/dist/js/select2.min.js"></script>

      <script src="/asset/js/voters.js"></script>
</body>

</html>