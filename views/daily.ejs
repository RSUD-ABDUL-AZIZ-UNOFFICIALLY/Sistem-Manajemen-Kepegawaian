<!DOCTYPE html>
<html lang="id" data-theme="light">
<head>
    <%- include('template/head'); %>
    <meta name="description" content="Produktivitas kerja Kepegawaian RSUD dr. Abdul Aziz Singkawang">
</head>

<body class="bg-base-200 text-base-content font-sans antialiased">
    <!-- Wrapper Utama Drawer DaisyUI -->
    <div class="drawer lg:drawer-open">
        <input id="main-drawer" type="checkbox" class="drawer-toggle" />
        
        <!-- Konten Utama -->
        <div class="drawer-content flex flex-col min-h-screen">
            
            <!-- Navbar -->
            <%- include('template/navbar'); %>

            <!-- Content Header -->
            <header class="w-full p-4 md:p-6 pb-2">
                <div class="flex flex-col md:flex-row md:items-center justify-between gap-4">
                    <div>
                        <h1 class="text-2xl font-bold tracking-tight">Laporan Harian</h1>
                    </div>
                    <div class="breadcrumbs text-sm">
                        <ul>
                            <li><a href="/">Home</a></li>
                            <li class="font-semibold">Produktivitas Kerja</li>
                        </ul>
                    </div>
                </div>
            </header>

            <!-- Main content -->
            <main class="flex-1 p-4 md:p-6">
                <!-- Membatasi lebar card maksimal 4xl agar form tidak memanjang ekstrem di layar besar -->
                <div class="container mx-auto max-w-4xl">
                    
                    <!-- Card DaisyUI -->
                    <div class="card bg-base-100 shadow-xl border border-base-200">
                        <div class="card-body">
                            <h2 class="card-title text-primary border-b border-base-200 pb-3 mb-4">
                                <i class="fas fa-edit mr-2"></i> Form Produktivitas Kerja
                            </h2>
                            
                            <!-- Form Start -->
                            <form id="Progress" class="space-y-5">
                                
                                <!-- Tanggal -->
                                <div class="form-control w-full">
                                    <label class="label" for="Tanggal">
                                        <span class="label-text font-semibold">Tanggal</span>
                                    </label>
                                    <input type="date" id="Tanggal" class="input input-bordered w-full hover:border-primary focus:border-primary transition-colors" required />
                                </div>
                                
                                <!-- Rincian Kegiatan -->
                                <div class="form-control w-full">
                                    <label class="label" for="InputActivities">
                                        <span class="label-text font-semibold">Rincian Kegiatan Kerja/Tugas</span>
                                    </label>
                                    <textarea id="InputActivities" class="textarea textarea-bordered h-28 w-full hover:border-primary focus:border-primary transition-colors" placeholder="contoh 'Hand Over pasien'" required autocomplete="on"></textarea>
                                </div>
                                
                                <!-- Volume -->
                                <div class="form-control w-full">
                                    <label class="label" for="InputVolume">
                                        <span class="label-text font-semibold">Volume Aktivitas</span>
                                    </label>
                                    <input type="number" id="InputVolume" class="input input-bordered w-full hover:border-primary focus:border-primary transition-colors" placeholder="Banyak aktivitas" required />
                                </div>
                                
                                <!-- Satuan -->
                                <div class="form-control w-full">
                                    <label class="label" for="Unit">
                                        <span class="label-text font-semibold">Satuan Kegiatan</span>
                                    </label>
                                    <select id="Unit" class="select select-bordered w-full hover:border-primary focus:border-primary transition-colors">
                                        <option value="-">-</option>
                                        <option value="Dokumen">Dokumen</option>
                                        <option value="Laporan">Laporan</option>
                                        <option value="Kegiatan">Kegiatan</option>
                                        <option value="Pasien">Pasien</option>
                                        <option value="Resep">Resep</option>
                                        <option value="Tindakan">Tindakan</option>
                                    </select>
                                </div>
                                
                                <!-- Waktu Penyelesaian -->
                                <div class="form-control w-full">
                                    <label class="label" for="InputCompletion">
                                        <span class="label-text font-semibold">Waktu Penyelesaian</span>
                                    </label>
                                    <!-- Pengganti input-group append Bootstrap -->
                                    <div class="join w-full">
                                        <input type="number" id="InputCompletion" class="input input-bordered join-item w-full hover:border-primary focus:border-primary transition-colors" placeholder="Total waktu penyelesaian kerja" required />
                                        <div class="btn btn-active join-item pointer-events-none rounded-r-lg">Menit</div>
                                    </div>
                                </div>

                                <!-- Card Footer / Action Buttons -->
                                <div class="flex flex-col sm:flex-row justify-between items-center mt-8 border-t border-base-200 pt-5 gap-4">
                                    <!-- Tombol Simpan di Kiri (Desktop) / Atas (Mobile) -->
                                    <div class="w-full sm:w-auto">
                                        <button type="submit" class="btn btn-primary w-full sm:w-auto">
                                            <i class="fas fa-save mr-1"></i> Simpan
                                        </button>
                                    </div>
                                    
                                    <!-- Tombol Template di Kanan -->
                                    <div class="flex flex-col sm:flex-row gap-2 w-full sm:w-auto">
                                        <button type="button" class="btn btn-info text-white w-full sm:w-auto" onclick="lihat()">
                                            <i class="fa-solid fa-note-sticky"></i> Lihat Template
                                        </button>
                                        <button type="button" class="btn btn-success text-white w-full sm:w-auto" onclick="simpan()">
                                            <i class="fa-solid fa-file-circle-plus"></i> Simpan Template
                                        </button>
                                    </div>
                                </div>

                            </form>
                            <!-- form end -->
                        </div>
                    </div>
                    
                </div>
            </main>
            
            <!-- Footer -->
            <footer class="footer footer-center p-4 bg-base-100 text-base-content border-t border-base-300 mt-auto">
                <aside>
                    <p>Copyright © <%= new Date().getFullYear() %> - RSUD dr. Abdul Aziz</p>
                </aside>
            </footer>
        </div>

        <!-- Sidebar Utama -->
        <%- include('template/sidebar'); %>
    </div>

    <!-- Modals & Scripts -->
    <%- include('modal/modalTemplate'); %> 
    <%- include('template/footer'); %>
    
    <script>
        let Tanggal = document.getElementById("Tanggal");
        let InputActivities = document.getElementById("InputActivities");
        // Limit backdate to 31 days
        Tanggal.max = new Date().toISOString().split("T")[0];
        Tanggal.min = new Date(new Date().setDate(new Date().getDate() - 31))
            .toISOString()
            .split("T")[0];
    </script>
    <script src="/asset/js/src/daily1.min.js"></script>
    <script src="/asset/js/template.js"></script>
</body>
</html>