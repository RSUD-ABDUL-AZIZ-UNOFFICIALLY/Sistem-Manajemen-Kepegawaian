<!DOCTYPE html>
<html lang="id" data-theme="light">

  <head>
    <%- include('template/head'); %>
    <meta name="description"
      content="Persetujuan Cuti Pegawai RSUD dr. Abdul Aziz Singkawang">
    <link rel="stylesheet" type="text/css"
      href="https://cdn.jsdelivr.net/npm/daterangepicker/daterangepicker.css" />
  </head>

  <body class="bg-base-200 text-base-content font-sans antialiased">
    <!-- Wrapper Utama Drawer DaisyUI -->
    <div class="drawer lg:drawer-open">
      <input id="main-drawer" type="checkbox" class="drawer-toggle" />

      <!-- Konten Utama -->
      <div class="drawer-content flex flex-col min-h-screen">

        <!-- Navbar -->
        <%- include('template/navbar'); %>

        <!-- Content Header -->
        <header class="w-full p-4 md:p-6 pb-2">
          <div
            class="flex flex-col md:flex-row md:items-center justify-between gap-4">
            <div>
              <h1 class="text-2xl font-bold tracking-tight">Persetujuan
                Cuti</h1>
            </div>
            <div class="breadcrumbs text-sm">
              <ul>
                <li><a href="/daily">Home</a></li>
                <li class="font-semibold">Persetujuan Cuti</li>
              </ul>
            </div>
          </div>
        </header>

        <!-- Main content -->
        <main class="flex-1 p-3 sm:p-4 md:p-6">
          <div class="container mx-auto max-w-7xl space-y-6">

            <!-- Card Utama -->
            <div
              class="card bg-base-100 shadow-xl border border-base-200 overflow-hidden">
              <div class="card-body p-4 sm:p-5 md:p-6 space-y-4">

                <!-- Header & Toolbar Filter -->
                <div
                  class="flex flex-col lg:flex-row lg:items-center justify-between gap-4 pb-4 border-b border-base-200">
                  <div>
                    <h2
                      class="card-title text-base md:text-lg font-bold text-base-content">
                      <i class="fas fa-clipboard-check text-primary mr-1"></i>
                      Daftar Anggota yang Mengajukan Cuti
                    </h2>
                    <p class="text-xs text-base-content/60 mt-0.5"
                      id="infoJumlahData">Menampilkan 0 pengajuan</p>
                  </div>

                  <!-- Kontrol Pencarian, Sort Mobile, & Tahun -->
                  <div
                    class="flex flex-col sm:flex-row items-stretch sm:items-center gap-2.5">
                    <!-- Pencarian Nama -->
                    <label
                      class="input input-bordered input-sm flex items-center gap-2 w-full sm:w-64 focus-within:border-primary">
                      <i class="fas fa-search text-base-content/50 text-xs"></i>
                      <input type="text" id="searchNama" class="grow"
                        placeholder="Cari nama anggota..." />
                      <button type="button" id="clearSearch"
                        class="hidden text-base-content/40 hover:text-base-content">
                        <i class="fas fa-times-circle text-xs"></i>
                      </button>
                    </label>

                    <!-- Sort Dropdown khusus Mobile -->
                    <select id="mobileSort"
                      class="select select-bordered select-sm lg:hidden w-full sm:w-auto">
                      <option value="default">Urutkan: Default</option>
                      <option value="nama-asc">Nama (A - Z)</option>
                      <option value="nama-desc">Nama (Z - A)</option>
                      <option value="mulai-desc">Tanggal Cuti (Terbaru)</option>
                      <option value="mulai-asc">Tanggal Cuti (Terlama)</option>
                      <option value="status-asc">Status</option>
                    </select>

                    <!-- Filter Tahun -->
                    <div
                      class="flex items-center justify-between sm:justify-start gap-2 bg-base-200/50 sm:bg-transparent px-3 py-1.5 sm:p-0 rounded-lg">
                      <label for="tahun"
                        class="text-xs sm:text-sm font-semibold text-base-content/70 whitespace-nowrap">Tahun:</label>
                      <input type="number" id="tahun" min="2023" max="2099"
                        step="1" value="2026"
                        class="input input-bordered input-sm w-24 text-center font-semibold hover:border-primary focus:border-primary transition-colors" />
                    </div>
                  </div>
                </div>

                <!-- TAMPILAN DESKTOP: Tabel Lebar Fix & Sortable -->
                <!-- TAMPILAN DESKTOP: Tabel Lebar Fix & Sortable -->
                <div
                  class="hidden lg:block max-h-[70vh] overflow-auto w-full rounded-lg border border-base-200 relative">
                  <table
                    class="table table-zebra table-auto w-full text-left border-collapse">
                    <thead class="sticky top-0 z-20 bg-base-200 shadow-sm">
                      <tr
                        class="text-[11px] font-bold text-base-content/80 uppercase tracking-wider select-none whitespace-nowrap">
                        <th class="w-12 text-center">#</th>
                        <th
                          class="min-w-45 cursor-pointer hover:bg-base-300/60 transition-colors"
                          onclick="sortTable('nama')">
                          <div class="flex items-center justify-between gap-2">
                            <span>Nama</span>
                            <i id="sort-icon-nama"
                              class="fas fa-sort text-base-content/30"></i>
                          </div>
                        </th>
                        <th
                          class="min-w-35 cursor-pointer hover:bg-base-300/60 transition-colors"
                          onclick="sortTable('mulai')">
                          <div class="flex items-center justify-between gap-2">
                            <span>Tanggal Cuti</span>
                            <i id="sort-icon-mulai"
                              class="fas fa-sort text-base-content/30"></i>
                          </div>
                        </th>
                        <th
                          class="min-w-28 cursor-pointer hover:bg-base-300/60 transition-colors"
                          onclick="sortTable('tipe')">
                          <div class="flex items-center justify-between gap-2">
                            <span>Tipe</span>
                            <i id="sort-icon-tipe"
                              class="fas fa-sort text-base-content/30"></i>
                          </div>
                        </th>
                        <th
                          class="min-w-18 text-center cursor-pointer hover:bg-base-300/60 transition-colors"
                          onclick="sortTable('jumlah')">
                          <div class="flex items-center justify-center gap-1">
                            <span>Hari</span>
                            <i id="sort-icon-jumlah"
                              class="fas fa-sort text-base-content/30"></i>
                          </div>
                        </th>
                        <th
                          class="min-w-18 text-center cursor-pointer hover:bg-base-300/60 transition-colors"
                          onclick="sortTable('sisa')">
                          <div class="flex items-center justify-center gap-1">
                            <span>Sisa</span>
                            <i id="sort-icon-sisa"
                              class="fas fa-sort text-base-content/30"></i>
                          </div>
                        </th>
                        <th class="min-w-45">Alasan Cuti</th>
                        <th class="min-w-38">Alamat</th>
                        <th
                          class="min-w-28 text-center cursor-pointer hover:bg-base-300/60 transition-colors"
                          onclick="sortTable('status')">
                          <div class="flex items-center justify-center gap-1">
                            <span>Status</span>
                            <i id="sort-icon-status"
                              class="fas fa-sort text-base-content/30"></i>
                          </div>
                        </th>
                        <th
                          class="min-w-31 cursor-pointer hover:bg-base-300/60 transition-colors"
                          onclick="sortTable('approve')">
                          <div class="flex items-center justify-between gap-2">
                            <span>Tgl Approve</span>
                            <i id="sort-icon-approve"
                              class="fas fa-sort text-base-content/30"></i>
                          </div>
                        </th>
                        <th class="min-w-25 text-center">Pratinjau</th>
                        <th class="min-w-38">Keterangan</th>
                        <th class="min-w-24 text-center">Lampiran</th>
                      </tr>
                    </thead>
                    <tbody id="tbodyCuti" class="text-xs align-top">
                      <!-- Baris data desktop diisi via JS -->
                    </tbody>
                  </table>
                </div>
              </div>
            </div>
          </main>

          <!-- Footer -->
          <footer
            class="footer footer-center p-4 bg-base-100 text-base-content border-t border-base-300 mt-auto">
            <aside>
              <p>Copyright © <%= new Date().getFullYear() %> RSUD dr. Abdul
                Aziz</p>
            </aside>
          </footer>
        </div>

        <!-- Sidebar Utama -->
        <%- include('template/sidebar'); %>
      </div>

      <!-- Modal Template DaisyUI Native (Menggantikan modal Bootstrap jika diperlukan, atau kompatibel dengan modalTemplate Anda) -->
      <%- include('modal/modalTemplate'); %>

      <!-- Footer Scripts -->
      <%- include('template/footer'); %>
      <script type="text/javascript"
        src="https://cdn.jsdelivr.net/jquery/latest/jquery.min.js"></script>
      <script type="text/javascript"
        src="https://cdn.jsdelivr.net/momentjs/latest/moment.min.js"></script>
      <script type="text/javascript"
        src="https://cdn.jsdelivr.net/npm/daterangepicker/daterangepicker.min.js"></script>
      <script src="/asset/js/aprovementcuti_2.min.js"></script>
    </body>

  </html>