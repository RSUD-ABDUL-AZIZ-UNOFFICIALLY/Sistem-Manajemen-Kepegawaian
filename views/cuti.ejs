<!DOCTYPE html>
<html lang="id" data-theme="light">

<head>
  <%- include('template/head'); %>
  <meta name="description" content="Pengajuan Cuti Pegawai RSUD dr. Abdul Aziz Singkawang">
  <link rel="stylesheet" type="text/css" href="https://cdn.jsdelivr.net/npm/daterangepicker/daterangepicker.css" />
</head>

<body class="bg-base-200 text-base-content font-sans antialiased">
  <!-- Wrapper Utama Drawer DaisyUI -->
  <div class="drawer lg:drawer-open">
    <input id="main-drawer" type="checkbox" class="drawer-toggle" />
    
    <!-- Konten Utama -->
    <div class="drawer-content flex flex-col min-h-screen">
      
      <!-- Navbar -->
      <%- include('template/navbar'); %>

      <!-- Content Header -->
      <header class="w-full p-4 md:p-6 pb-2">
        <div class="flex flex-col md:flex-row md:items-center justify-between gap-4">
          <div>
            <h1 class="text-2xl font-bold tracking-tight">Pengajuan Cuti</h1>
          </div>
          <div class="breadcrumbs text-sm">
            <ul>
              <li><a href="/daily">Home</a></li>
              <li class="font-semibold">Formulir Cuti</li>
            </ul>
          </div>
        </div>
      </header>

      <!-- Main content -->
      <main class="flex-1 p-4 md:p-6 space-y-6">
        <div class="container mx-auto max-w-5xl space-y-6">
          
          <!-- Card Formulir Pengajuan Cuti -->
          <div class="card bg-base-100 shadow-xl border border-base-200">
            <div class="card-body p-5 md:p-6">
              <h2 class="card-title text-primary border-b border-base-200 pb-3 mb-4">
                <i class="fas fa-file-signature mr-2"></i> Formulir Pengajuan Cuti
              </h2>
              
              <!-- Form Start -->
              <form id="Cuti" class="space-y-4">
                
                <!-- Jenis Cuti -->
                <div class="form-control w-full">
                  <label class="label" for="jnsCuti">
                    <span class="label-text font-semibold">Jenis Cuti</span>
                  </label>
                  <select id="jnsCuti" class="select select-bordered w-full hover:border-primary focus:border-primary transition-colors" >
                    <option value="" disabled selected>Pilih Jenis Cuti</option>
                  </select>
                </div>

                <!-- Rentang Tanggal & Durasi -->
                <div class="form-control w-full">
                  <label class="label">
                    <span class="label-text font-semibold">Pilih Tanggal Pengajuan Cuti</span>
                  </label>
                  
                  <div class="grid grid-cols-1 md:grid-cols-12 gap-3">
                    <!-- Input Date Range -->
                    <div class="md:col-span-8">
                      <div class="join w-full">
                        <span class="btn btn-active join-item pointer-events-none">
                          <i class="far fa-calendar-alt"></i>
                        </span>
                        <input type="text" id="reservation" name="reservation" class="input input-bordered join-item w-full hover:border-primary focus:border-primary transition-colors" placeholder="DD/MM/YYYY - DD/MM/YYYY" required disabled />
                      </div>
                    </div>
                    
                    <!-- Input Total Hari -->
                    <div class="md:col-span-4">
                      <div class="join w-full">
                        <input type="number" id="totalReservation" class="input input-bordered join-item w-full text-center font-bold hover:border-primary focus:border-primary transition-colors" placeholder="0" required disabled />
                        <span class="btn btn-active join-item pointer-events-none">Hari</span>
                      </div>
                    </div>
                  </div>
                </div>

                <!-- Alasan Cuti -->
                <div class="form-control w-full">
                  <label class="label" for="alasanCuti">
                    <span class="label-text font-semibold">Alasan Cuti</span>
                  </label>
                  <textarea id="alasanCuti" class="textarea textarea-bordered h-24 w-full hover:border-primary focus:border-primary transition-colors" placeholder="Contoh: 'Pulang Kampung'" required autocomplete="on"></textarea>
                </div>

                <!-- Alamat Selama Cuti -->
                <div class="form-control w-full">
                  <label class="label" for="alamat">
                    <span class="label-text font-semibold">Alamat Selama Cuti</span>
                  </label>
                  <textarea id="alamat" class="textarea textarea-bordered h-24 w-full hover:border-primary focus:border-primary transition-colors" placeholder="Contoh: 'Jl. Dr. Sutomo No.28, Pasiran, Singkawang Barat'" required autocomplete="on"></textarea>
                </div>

                <!-- Container Dynamic Lampiran File -->
                <div id="lampiran" class="form-control w-full space-y-2"></div>

                <!-- Note / Keterangan Cuti -->
                <div class="bg-base-200/60 p-3 rounded-lg border border-base-300">
                  <p class="text-xs text-base-content/80 flex items-start gap-2">
                    <i class="fas fa-info-circle text-info mt-0.5"></i>
                    <span id="Keterangan_cuti">Pilih jenis cuti terlebih dahulu untuk melihat ketentuan maksimal hari.</span>
                  </p>
                </div>

                <!-- Action Submit -->
                <div class="flex justify-end pt-4 border-t border-base-200">
                  <button type="submit" id="btnSubmit" class="btn btn-primary w-full sm:w-auto">
                    <i class="fas fa-paper-plane mr-1"></i> Ajukan Cuti
                  </button>
                </div>

              </form>
            </div>
          </div>

          <!-- Card Riwayat Cuti -->
      <div class="card bg-base-100 shadow-xl border border-base-200 overflow-hidden">
  <div class="card-body p-4 sm:p-5 md:p-6 space-y-4">
    
    <!-- Header & Toolbar Filter -->
    <div class="flex flex-col lg:flex-row lg:items-center justify-between gap-4 pb-4 border-b border-base-200">
      <div>
        <h2 class="card-title text-base md:text-lg font-bold text-base-content">
          <i class="fas fa-history text-primary mr-1"></i> Riwayat Pengajuan Cuti
        </h2>
        <p class="text-xs text-base-content/60 mt-0.5" id="infoJumlahRiwayat">Menampilkan 0 riwayat cuti</p>
      </div>

      <!-- Kontrol Pencarian, Filter/Sort, & Tahun -->
      <div class="flex flex-col sm:flex-row items-stretch sm:items-center gap-2.5">
        <!-- Pencarian Tipe / Alasan / Atasan -->
        <label class="input input-bordered input-sm flex items-center gap-2 w-full sm:w-60 focus-within:border-primary">
          <i class="fas fa-search text-base-content/50 text-xs"></i>
          <input type="text" id="searchRiwayat" class="grow" placeholder="Cari tipe, alasan, atasan..." />
          <button type="button" id="clearSearchRiwayat" class="hidden text-base-content/40 hover:text-base-content">
            <i class="fas fa-times-circle text-xs"></i>
          </button>
        </label>

        <!-- Sort Dropdown khusus Mobile -->
        <select id="mobileSortRiwayat" class="select select-bordered select-sm lg:hidden w-full sm:w-auto">
          <option value="default">Urutkan: Default</option>
          <option value="mulai-desc">Tanggal Cuti (Terbaru)</option>
          <option value="mulai-asc">Tanggal Cuti (Terlama)</option>
          <option value="tipe-asc">Tipe Cuti (A - Z)</option>
          <option value="status-asc">Status</option>
        </select>

        <!-- Filter Tahun -->
        <div class="flex items-center justify-between sm:justify-start gap-2 bg-base-200/50 sm:bg-transparent px-3 py-1.5 sm:p-0 rounded-lg">
          <label for="tahun" class="text-xs sm:text-sm font-semibold text-base-content/70 whitespace-nowrap">Tahun:</label>
          <input type="number" id="tahun" min="2024" max="2099" step="1" value="2026" class="input input-bordered input-sm w-24 text-center font-semibold hover:border-primary focus:border-primary transition-colors" />
        </div>
      </div>
    </div>

    <!-- TAMPILAN DESKTOP: Sticky Header, Lebar Fix, Sortable -->
    <div class="hidden lg:block max-h-[70vh] overflow-y-auto overflow-x-auto w-full rounded-lg border border-base-200 relative">
      <table class="table table-zebra table-fixed w-full text-left border-collapse">
        <thead class="sticky top-0 z-20 bg-base-200 shadow-sm">
          <tr class="text-[11px] font-bold text-base-content/80 uppercase tracking-wider select-none">
            <th class="w-10 text-center">#</th>
            <th class="w-36 cursor-pointer hover:bg-base-300/60 transition-colors" onclick="sortRiwayat('mulai')">
              <div class="flex items-center justify-between">
                <span>Tanggal Cuti</span>
                <i id="sort-icon-mulai" class="fas fa-sort text-base-content/30"></i>
              </div>
            </th>
            <th class="w-28 cursor-pointer hover:bg-base-300/60 transition-colors" onclick="sortRiwayat('tipe')">
              <div class="flex items-center justify-between">
                <span>Tipe Cuti</span>
                <i id="sort-icon-tipe" class="fas fa-sort text-base-content/30"></i>
              </div>
            </th>
            <th class="w-16 text-center cursor-pointer hover:bg-base-300/60 transition-colors" onclick="sortRiwayat('jumlah')">
              <div class="flex items-center justify-center gap-1">
                <span>Hari</span>
                <i id="sort-icon-jumlah" class="fas fa-sort text-base-content/30"></i>
              </div>
            </th>
            <th class="w-36">Alasan Cuti</th>
            <th class="w-24 text-center cursor-pointer hover:bg-base-300/60 transition-colors" onclick="sortRiwayat('status')">
              <div class="flex items-center justify-center gap-1">
                <span>Status</span>
                <i id="sort-icon-status" class="fas fa-sort text-base-content/30"></i>
              </div>
            </th>
            <th class="w-32 cursor-pointer hover:bg-base-300/60 transition-colors" onclick="sortRiwayat('approve')">
              <div class="flex items-center justify-between">
                <span>Tgl Approve</span>
                <i id="sort-icon-approve" class="fas fa-sort text-base-content/30"></i>
              </div>
            </th>
            <th class="w-36 cursor-pointer hover:bg-base-300/60 transition-colors" onclick="sortRiwayat('atasan')">
              <div class="flex items-center justify-between">
                <span>Nama Atasan</span>
                <i id="sort-icon-atasan" class="fas fa-sort text-base-content/30"></i>
              </div>
            </th>
            <th class="w-28">Keterangan</th>
            <th class="w-36 text-center">Tindakan</th>
            <th class="w-20 text-center">Lampiran</th>
          </tr>
        </thead>
        <tbody id="tbodyRiwayatCuti" class="text-xs">
          <!-- Baris data desktop diisi dinamis via JavaScript -->
        </tbody>
      </table>
    </div>

    <!-- TAMPILAN MOBILE: Card List Responsif -->
    <div id="mobileRiwayatContainer" class="block lg:hidden space-y-3">
      <!-- Card data mobile diisi dinamis via JavaScript -->
    </div>

  </div>
</div>

        </div>
      </main>

      <!-- Footer -->
      <footer class="footer footer-center p-4 bg-base-100 text-base-content border-t border-base-300 mt-auto">
        <aside>
          <p>Copyright © <%= new Date().getFullYear() %> RSUD dr. Abdul Aziz</p>
        </aside>
      </footer>
    </div>

    <!-- Sidebar Utama -->
    <%- include('template/sidebar'); %>
  </div>

  <!-- Footer Scripts -->
  <%- include('template/footer'); %>
  <script type="text/javascript" src="https://cdn.jsdelivr.net/jquery/latest/jquery.min.js"></script>
  <script type="text/javascript" src="https://cdn.jsdelivr.net/momentjs/latest/moment.min.js"></script>
  <script type="text/javascript" src="https://cdn.jsdelivr.net/npm/daterangepicker/daterangepicker.min.js"></script>
  <!-- <script src="/asset/js/src/cuti1v6.min.js"></script> -->
  <script src="/asset/js/cuti.js"></script>
</body>

</html>