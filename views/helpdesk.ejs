<!DOCTYPE html>
<html lang="id">

<head>
  <%- include('template/head'); %>
  <menu name="description" content="Pengajuan Bnatuan TI Pegawai RSUD dr. Abdul Aziz Singkawang">
  <link rel="stylesheet" href="/asset/css/index2.min.css">
</head>

<body class="hold-transition sidebar-mini layout-fixed">
  <div class="wrapper">
    <!-- Navbar -->
    <%- include('template/navbar'); %>
      <!-- /.navbar -->

      <!-- Main Sidebar Container -->
      <%- include('template/sidebar'); %>

        <!-- Content Wrapper. Contains page content -->
        <div class="content-wrapper">
          <!-- Content Header (Page header) -->
          <%- include('template/content-header'); %>
            <!-- /.content-header -->

            <!-- Main content -->
            <section class="p-4 md:p-6 bg-gray-50 min-h-screen">
              <div class="max-w-6xl mx-auto space-y-6">
                <!-- Form Section: Dukungan TI -->
                <div class="bg-white rounded-lg shadow-md border border-gray-200 overflow-hidden">
                  <div class="bg-blue-400 text-white px-4 md:px-6 py-4">
                    <h3 class="text-lg md:text-xl font-bold">Dukungan TI</h3>
                  </div>
                  
                  <form id="lapor" class="p-4 md:p-6 space-y-5">
                    <!-- Kendala Textarea -->
                    <div>
                      <label for="kendala" class="block text-sm font-semibold text-gray-700 mb-2">Rincian kendala atau masalah yang dihadapi</label>
                      <textarea class="w-full px-4 py-3 border border-gray-300 rounded-lg focus:outline-none focus:ring-2 focus:ring-blue-300 focus:border-transparent bg-white text-gray-900 resize-vertical min-h-24" id="kendala" rows="3" placeholder="Contoh: 'Printer x macet'" required autocomplete="on"></textarea>
                    </div>

                    <!-- Departemen Select -->
                    <div>
                      <label for="departemen" class="block text-sm font-semibold text-gray-700 mb-2">Unit Kerja Saya</label>
                      <select class="w-full px-4 py-3 border border-gray-300 rounded-lg focus:outline-none focus:ring-2 focus:ring-blue-300 focus:border-transparent bg-white text-gray-900" id="departemen">
                        <option selected="selected" value='<%= user.dep%>'>
                          <%= user.departemen.bidang%>
                        </option>
                        <% for(let i=0; i<departemen.length; i++) { %>
                          <option value='<%= departemen[i].id %>'>
                            <%= departemen[i].bidang %>
                          </option>
                          <% } %>
                      </select>
                    </div>

                    <!-- Grup Tiket Select -->
                    <div>
                      <label for="grubtiket" class="block text-sm font-semibold text-gray-700 mb-2">Ditujukan Kepada</label>
                      <select class="w-full px-4 py-3 border border-gray-300 rounded-lg focus:outline-none focus:ring-2 focus:ring-blue-300 focus:border-transparent bg-white text-gray-900" id="grubtiket" required>
                        <option selected="selected" value="">Pilih tujuan</option>
                        <% for(let i=0; i<addgrubtiket.length; i++) { %>
                          <option value='<%= addgrubtiket[i].id %>'>
                            <%= addgrubtiket[i].nama_grup %> - <%= addgrubtiket[i].nama_pj %>
                          </option>
                          <% } %>
                      </select>
                    </div>

                    <!-- Topic Select -->
                    <div>
                      <label for="topic" class="block text-sm font-semibold text-gray-700 mb-2">Topik</label>
                      <select class="w-full px-4 py-3 border border-gray-300 rounded-lg focus:outline-none focus:ring-2 focus:ring-blue-300 focus:border-transparent bg-white text-gray-900" id="topic">
                        <option value="-">-</option>
                        <option value="Printer">Printer</option>
                        <option value="Komputer">Komputer</option>
                        <option value="Internet">Internet</option>
                        <option value="SIMRS">SIMRS</option>
                        <option value="Aplikasi Lainnya">Aplikasi Lainnya</option>
                        <option value="Lainnya">Lainnya</option>
                      </select>
                    </div>

                    <!-- Submit Button -->
                    <div class="flex justify-start">
                      <button id="submit" type="submit" class="bg-blue-400 hover:bg-blue-500 disabled:bg-gray-400 disabled:cursor-not-allowed text-white font-semibold py-3 md:py-2 px-8 rounded-lg transition-colors duration-200">
                        Kirim
                      </button>
                    </div>
                  </form>
                </div>

                <!-- History Section: Riwayat Pengaduan -->
                <div class="bg-white rounded-lg shadow-md border border-gray-200 overflow-hidden">
                  <div class="bg-green-400 text-white px-4 md:px-6 py-4">
                    <h3 class="text-lg md:text-xl font-bold">Riwayat Pengaduan</h3>
                  </div>
                  
                  <div class="p-4 md:p-6">
                    <!-- Month Filter -->
                    <div class="mb-6">
                      <label for="riwayatDate" class="block text-sm font-semibold text-gray-700 mb-2">Filter Bulan</label>
                      <input type="month" class="w-full md:w-48 px-4 py-2 border border-gray-300 rounded-lg focus:outline-none focus:ring-2 focus:ring-green-300 focus:border-transparent" id="riwayatDate" name="start" min="2023-03" />
                    </div>

                    <!-- Desktop Table View -->
                    <div class="hidden md:block overflow-x-auto">
                      <table class="w-full border-collapse">
                        <thead>
                          <tr class="bg-green-400 text-white">
                            <th class="border border-gray-300 px-4 py-3 text-left text-sm font-semibold w-12">#</th>
                            <th class="border border-gray-300 px-4 py-3 text-left text-sm font-semibold">Tanggal</th>
                            <th class="border border-gray-300 px-4 py-3 text-left text-sm font-semibold">No Tiket</th>
                            <th class="border border-gray-300 px-4 py-3 text-left text-sm font-semibold">Kendala</th>
                            <th class="border border-gray-300 px-4 py-3 text-left text-sm font-semibold">Topik</th>
                            <th class="border border-gray-300 px-4 py-3 text-left text-sm font-semibold w-40">Aksi</th>
                          </tr>
                        </thead>
                        <tbody id="table-desktop"></tbody>
                      </table>
                    </div>

                    <!-- Mobile Card View -->
                    <div class="md:hidden space-y-3" id="cards-mobile"></div>
                  </div>
                </div>
              </div>
            </section>
            <!-- /.content -->
        </div>
        <!-- /.content-wrapper -->
        <footer class="main-footer"></footer>
  </div>
  <!-- ./wrapper -->
  <%- include('modal/modalStatusHelp'); %>
  <%- include('template/footer'); %>
      <script src="/asset/js/helpdesk.js"></script>
</body>

</html>